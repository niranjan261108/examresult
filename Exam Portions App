// Used right after a save so the table always reflects exactly what
// you just typed, instead of a possibly-stale re-read.
function renderTimetableRows(){
  document.getElementById("tt-class-title").textContent=currentClass;

  const meta=ttMetaCache||{label:"",subjects:{}};
  const teacherPositions=ttTeacherPositionsCache||{};

  document.getElementById("tt-label").textContent=meta.label||
    (currentType==="weekly"?"Weekly Test Schedule":"Monthly Test Schedule");
  document.getElementById("tt-class").textContent=currentClass;

  document.getElementById("tt-edit-btn").textContent=ttEditMode?"Editing…":"Edit";
  document.getElementById("tt-save-row").style.display=ttEditMode?"flex":"none";

  const subjects=ttSubjectsCache.length?ttSubjectsCache:subjectsFor(currentClass);
  const rows=subjects
    .map(subj=>{
      const ownerEntry=meta.subjects[subj]||{};
      const portions=ownerEntry.portions||teacherPositions[subj]||"";
      const label=(ttLabelsCache&&ttLabelsCache[subj])||subj;
      return {subj,label,date:ownerEntry.date||"",portions};
    })
    .filter(r=>r.date)
    .sort((a,b)=>a.date.localeCompare(b.date));

  const tbody=document.getElementById("tt-rows");
  tbody.innerHTML="";

  if(rows.length===0){
    const tr=document.createElement("tr");
    const td=document.createElement("td");
    td.colSpan=4;td.className="tt-empty";
    td.textContent="No test dates set yet for this class — add them in the Owner portal.";
    tr.appendChild(td);tbody.appendChild(tr);
    return;
  }

  rows.forEach(r=>{
    const tr=document.createElement("tr");

    if(ttEditMode){
      const tdDate=document.createElement("td");
      const inpDate=document.createElement("input");
      inpDate.type="date";inpDate.value=r.date;inpDate.dataset.origSubject=r.subj;inpDate.className="tt-edit-date";
      tdDate.appendChild(inpDate);

      const tdDay=document.createElement("td");
      tdDay.textContent=dayName(r.date);
      inpDate.addEventListener("input",()=>{tdDay.textContent=dayName(inpDate.value);});

      const tdSubj=document.createElement("td");
      const inpSubj=document.createElement("input");
      inpSubj.type="text";inpSubj.value=r.label;inpSubj.dataset.origSubject=r.subj;inpSubj.className="tt-edit-subject";
      tdSubj.appendChild(inpSubj);

      const tdPort=document.createElement("td");
      const inpPort=document.createElement("input");
      inpPort.type="text";inpPort.value=r.portions;inpPort.dataset.origSubject=r.subj;inpPort.className="tt-edit-portions";
      inpPort.placeholder="Syllabus portion / topic";
      tdPort.appendChild(inpPort);

      tr.appendChild(tdDate);tr.appendChild(tdDay);tr.appendChild(tdSubj);tr.appendChild(tdPort);
    }else{
      [formatDateDMY(r.date),dayName(r.date),r.label,r.portions||"—"].forEach(v=>{
        const td=document.createElement("td");td.textContent=v;tr.appendChild(td);
      });
    }
    tbody.appendChild(tr);
  });
}

