async function saveTimetableEdits(){
  const base=(ttMetaCache&&ttMetaCache.subjects)||{};
  const updated={};
  Object.keys(base).forEach(s=>{updated[s]={...base[s]};});

  // Each visible row has a date / subject / portions input sharing the same
  // permanent subject id in data-orig-subject. The id NEVER changes here —
  // a rename is captured separately as a display label, so date/portions
  // always stay reachable under their original id.
  const dateInputs=[...document.querySelectorAll(".tt-edit-date")];
  const subjInputs=[...document.querySelectorAll(".tt-edit-subject")];
  const portInputs=[...document.querySelectorAll(".tt-edit-portions")];

  const subjNameMap={};
  dateInputs.forEach((dateInp,i)=>{
    const origSubj=dateInp.dataset.origSubject;
    const subjInp=subjInputs[i];
    const portInp=portInputs[i];
    subjNameMap[origSubj]=(subjInp&&subjInp.value.trim())||origSubj;

    updated[origSubj]={
      date:dateInp.value||"",
      portions:(portInp?portInp.value.trim():"")
    };
  });

  const label=(ttMetaCache&&ttMetaCache.label)||"";
  try{
    const res=await setSaved(oKey(),{label,subjects:updated});
    if(!res)throw new Error("no result");
    await saveSubjectLabelChanges(currentClass,subjNameMap);
    ttEditMode=false;
    // Update the local cache directly from what was just saved and redraw
    // from that, rather than re-fetching — avoids showing stale data if
    // the read races ahead of the write.
    ttMetaCache={label,subjects:updated};
    ttLabelsCache=await getSubjectLabels(currentClass);
    flash("tt-status");
    renderTimetableRows();
  }catch(e){
    const el=document.getElementById("tt-status");
    el.textContent="Could not save — try again";
    el.style.color="#B3261E";
    el.classList.add("show");
    setTimeout(()=>{el.classList.remove("show");el.textContent="Saved";el.style.color="";},2500);
  }
}

/* ── Seating Arrangement (manual per-room roll entry + staff dropdown) ── */
const SEATING_ROOMS=[
  {id:"gf1",name:"Ground Floor — 1st Half"},
  {id:"gf2",name:"Ground Floor — 2nd Half"},
  {id:"ff",name:"First Floor"}
];
let seatingDates=[];              // [{id,date,cells:{roomId:{rolls,teacher:{id,name}}}}]
let seatingRoomsChecked={gf1:true,gf2:true,ff:false};
let seatingTeachersList=[];       // [{id,name,password}] from settings:teachers

function seatingKey(){return"seating:current";}

function countRolls(str){
  if(!str)return 0;
  return str.split(",").map(s=>s.trim()).filter(Boolean).length;
}

async function renderStaffInvigilation(){
  if(!loggedInTeacher)return;
  const tbody=document.getElementById("staff-invigilation-rows");
  if(!tbody)return;

  const saved=await getSaved(seatingKey());
  const dates=(saved&&saved.dates)||[];
  const todayStr=new Date().toISOString().slice(0,10);

  const rows=[];
  dates.forEach(d=>{
    SEATING_ROOMS.forEach(r=>{
      const cell=d.cells&&d.cells[r.id];
      if(cell&&cell.teacher&&cell.teacher.id===loggedInTeacher.id){
        rows.push({date:d.date||"",roomName:r.name,count:countRolls(cell.rolls)});
      }
    });
  });

  rows.sort((a,b)=>(a.date||"").localeCompare(b.date||""));
  const upcoming=rows.filter(r=>r.date&&r.date>=todayStr);

  tbody.innerHTML="";

  if(upcoming.length===0){
    const tr=document.createElement("tr");
    const td=document.createElement("td");
    td.colSpan=3;td.style.cssText="padding:20px;text-align:center;color:var(--text-soft);";
    td.textContent="No invigilation duty assigned to you right now.";
    tr.appendChild(td);tbody.appendChild(tr);
    return;
  }

  upcoming.forEach(r=>{
    const tr=document.createElement("tr");
    const tdDate=document.createElement("td");
    tdDate.style.cssText="font-weight:600;color:var(--navy-dark);";
    tdDate.textContent=formatDate(r.date)+" ("+dayName(r.date)+")";
    const tdRoom=document.createElement("td");
    tdRoom.textContent=r.roomName;
    const tdCount=document.createElement("td");
    tdCount.textContent=r.count;
    tr.appendChild(tdDate);tr.appendChild(tdRoom);tr.appendChild(tdCount);
    tbody.appendChild(tr);
  });
}

function activeSeatingRooms(){
  return SEATING_ROOMS.filter(r=>seatingRoomsChecked[r.id]!==false);
}

function renderSeatingRoomToggles(){
  const wrap=document.getElementById("seat-room-rows");
  wrap.innerHTML="";
  SEATING_ROOMS.forEach(r=>{
    const label=document.createElement("label");
    label.className="seat-room-toggle";
    const chk=document.createElement("input");
    chk.type="checkbox";
    chk.checked=seatingRoomsChecked[r.id]!==false;
    chk.onchange=()=>{
      seatingRoomsChecked[r.id]=chk.checked;
      renderSeatingTable();
    };
    label.appendChild(chk);
    label.appendChild(document.createTextNode(r.name));
    wrap.appendChild(label);
  });
}

function buildTeacherSelect(dateId,roomId,selected){
  const select=document.createElement("select");
  select.className="seat-teacher-input";
  select.id="seat-teacher-"+dateId+"-"+roomId;

  const blank=document.createElement("option");
  blank.value="";blank.textContent="— Select teacher —";
  select.appendChild(blank);

  let matched=false;
  seatingTeachersList.forEach(t=>{
    const opt=document.createElement("option");
    opt.value=t.id;opt.textContent=t.name;
    if(selected&&selected.id===t.id){opt.selected=true;matched=true;}
    select.appendChild(opt);
  });

  if(selected&&selected.id&&!matched){
    const opt=document.createElement("option");
    opt.value=selected.id;
    opt.textContent=(selected.name||"Unknown")+" (removed from staff list)";
    opt.selected=true;
    select.appendChild(opt);
  }
  return select;
}

function collectSeatingStateFromDOM(){
  seatingDates.forEach(d=>{
    const dateInput=document.getElementById("seat-date-"+d.id);
    if(dateInput)d.date=dateInput.value;
    SEATING_ROOMS.forEach(r=>{
      const rollsEl=document.getElementById("seat-rolls-"+d.id+"-"+r.id);
      if(rollsEl)d.cells[r.id].rolls=rollsEl.value;
      const sel=document.getElementById("seat-teacher-"+d.id+"-"+r.id);
      if(sel){
        const opt=sel.options[sel.selectedIndex];
        d.cells[r.id].teacher=sel.value?{id:sel.value,name:(opt?opt.textContent:"").replace(" (removed from staff list)","")}:null;
      }
    });
  });
}

function addSeatingDateRow(data){
  collectSeatingStateFromDOM();
  const id=(data&&data.id)?data.id:"d"+Date.now()+Math.floor(Math.random()*1000);
  const cells={};
  SEATING_ROOMS.forEach(r=>{
    cells[r.id]={
      rolls:(data&&data.cells&&data.cells[r.id]&&data.cells[r.id].rolls)||"",
      teacher:(data&&data.cells&&data.cells[r.id]&&data.cells[r.id].teacher)||null
    };
  });
  seatingDates.push({id,date:(data&&data.date)||"",cells});
  renderSeatingTable();
}

function removeSeatingDateRow(id){
  collectSeatingStateFromDOM();
  seatingDates=seatingDates.filter(d=>d.id!==id);
  renderSeatingTable();
}

function renderSeatingTable(){
  const rooms=activeSeatingRooms();
  const thead=document.getElementById("seat-thead");
  const tbody=document.getElementById("seat-tbody");
  thead.innerHTML="";
  tbody.innerHTML="";

  const headRow=document.createElement("tr");
  let headHtml="<th>Date</th>";
  rooms.forEach(r=>{headHtml+=`<th>${r.name}</th>`;});
  headHtml+="<th></th>";
  headRow.innerHTML=headHtml;
  thead.appendChild(headRow);

  seatingDates.forEach(d=>{
    const tr=document.createElement("tr");

    const tdDate=document.createElement("td");
    const dateInput=document.createElement("input");
    dateInput.type="date";dateInput.id="seat-date-"+d.id;dateInput.value=d.date||"";
    tdDate.appendChild(dateInput);
    tr.appendChild(tdDate);

    rooms.forEach(r=>{
      const td=document.createElement("td");

      const rollsArea=document.createElement("textarea");
      rollsArea.className="seat-allrolls-input";
      rollsArea.id="seat-rolls-"+d.id+"-"+r.id;
      rollsArea.placeholder="e.g. 9101,9102,9106,7202,8102";
      rollsArea.value=d.cells[r.id].rolls;

      const countEl=document.createElement("div");
      countEl.className="seat-count";
      countEl.textContent="Students: "+countRolls(d.cells[r.id].rolls);

      rollsArea.oninput=()=>{
        countEl.textContent="Students: "+countRolls(rollsArea.value);
      };

      const teacherSelect=buildTeacherSelect(d.id,r.id,d.cells[r.id].teacher);

      td.appendChild(rollsArea);
      td.appendChild(countEl);
      td.appendChild(teacherSelect);
      tr.appendChild(td);
    });

    const tdDel=document.createElement("td");
    const delBtn=document.createElement("button");
    delBtn.className="seat-del-btn";
    delBtn.textContent="✕";
    delBtn.title="Remove this date";
    delBtn.onclick=()=>removeSeatingDateRow(d.id);
    tdDel.appendChild(delBtn);
    tr.appendChild(tdDel);

    tbody.appendChild(tr);
  });

  const hasRows=seatingDates.length>0;
  document.getElementById("seat-table-wrap").style.display=hasRows?"block":"none";
  document.getElementById("seat-empty-note").style.display=hasRows?"none":"block";
}

async function renderSeating(){
  const [saved,teachersStored]=await Promise.all([
    getSaved(seatingKey()),
    getSaved("settings:teachers")
  ]);
  seatingTeachersList=(teachersStored&&teachersStored.teachers)||[];

  document.getElementById("seat-exam-label").value=(saved&&saved.title)||"";
  seatingRoomsChecked=(saved&&saved.roomsChecked)||{gf1:true,gf2:true,ff:false};
  seatingDates=[];
  renderSeatingRoomToggles();

  if(saved&&saved.dates&&saved.dates.length){
    saved.dates.forEach(d=>{
      const cells={};
      SEATING_ROOMS.forEach(r=>{
        cells[r.id]={
          rolls:(d.cells&&d.cells[r.id]&&d.cells[r.id].rolls)||"",
          teacher:(d.cells&&d.cells[r.id]&&d.cells[r.id].teacher)||null
        };
      });
      seatingDates.push({
        id:d.id||("d"+Date.now()+Math.floor(Math.random()*1000)),
        date:d.date||"",
        cells
      });
    });
  }
  renderSeatingTable();
}

async function saveSeatingConfig(){
  collectSeatingStateFromDOM();
  const statusEl=document.getElementById("seat-status");
  const payload={
    title:document.getElementById("seat-exam-label").value.trim(),
    roomsChecked:seatingRoomsChecked,
    dates:seatingDates
  };
  try{
    const res=await setSaved(seatingKey(),payload);
    if(!res)throw new Error("save failed");
    flash("seat-status");
  }catch(e){
    statusEl.textContent="Could not save — try again";
    statusEl.style.color="#B3261E";
    statusEl.classList.add("show");
    setTimeout(()=>{statusEl.classList.remove("show");statusEl.textContent="Saved";statusEl.style.color="";},2500);
  }
}

async function downloadSeatingImage(){
  collectSeatingStateFromDOM();
  const sheet=document.getElementById("seat-table-wrap");
  const statusEl=document.getElementById("seat-status");
  if(!seatingDates.length){
    statusEl.textContent="Add at least one exam date first";
    statusEl.style.color="#B3261E";
    statusEl.classList.add("show");
    setTimeout(()=>{statusEl.classList.remove("show");statusEl.textContent="Saved";statusEl.style.color="";},2500);
    return;
  }

  // Temporarily expand the wrap so html2canvas captures the FULL table,
  // not just whatever portion is currently scrolled into view.
  const prevOverflowX=sheet.style.overflowX;
  const prevOverflowY=sheet.style.overflowY;
  const prevWidth=sheet.style.width;
  const prevMaxWidth=sheet.style.maxWidth;
  sheet.scrollLeft=0;
  sheet.style.overflowX="visible";
  sheet.style.overflowY="visible";
  sheet.style.maxWidth="none";
  sheet.style.width=sheet.scrollWidth+"px";

  try{
    const canvas=await html2canvas(sheet,{
      backgroundColor:"#ffffff",
      scale:2,
      width:sheet.scrollWidth,
      height:sheet.scrollHeight,
      windowWidth:sheet.scrollWidth,
      windowHeight:sheet.scrollHeight
    });
    const link=document.createElement("a");
    const label=slug(document.getElementById("seat-exam-label").value.trim()||"seating_arrangement");
    link.download=`${label}.png`;
    link.href=canvas.toDataURL("image/png");
    link.click();
  }catch(e){
    console.error("Image export failed:",e);
    statusEl.textContent="Could not create image — try again";
    statusEl.style.color="#B3261E";
    statusEl.classList.add("show");
    setTimeout(()=>{statusEl.classList.remove("show");statusEl.textContent="Saved";statusEl.style.color="";},2500);
  }finally{
    sheet.style.overflowX=prevOverflowX;
    sheet.style.overflowY=prevOverflowY;
    sheet.style.width=prevWidth;
    sheet.style.maxWidth=prevMaxWidth;
  }
}

/* ── Helpers ── */
function formatDate(iso){
  if(!iso)return"";
  const [y,m,d]=iso.split("-");
  const months=["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
  return `${parseInt(d)} ${months[parseInt(m)-1]} ${y}`;
}
function formatDateDMY(iso){
  if(!iso)return"";
  const [y,m,d]=iso.split("-");
  return `${d}-${m}-${y}`;
}
function dayName(iso){
  if(!iso)return"";
  const days=["Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"];
  const d=new Date(iso+"T00:00:00");
  return days[d.getDay()];
}
function flash(id){
  const el=document.getElementById(id);
  el.classList.add("show");
  setTimeout(()=>el.classList.remove("show"),1800);
}

/* ── Update checker ──
   Bump APP_VERSION every time you edit and redeploy this file. Format:
   YYYY-MM-DD-N (N = which change that day, so it still sorts correctly
   as plain text). The FIRST person to open a build with a higher
   version than what's stored publishes it to everyone else; anyone
   already on an older tab gets a "Refresh" banner instead of silently
   working on stale data. */
const APP_VERSION="2026-08-06-1";

async function syncAppVersion(){
  try{
    const saved=await getSaved("settings:app-version");
    const remote=(saved&&saved.version)||"";
    if(!remote||APP_VERSION>remote){
      await setSaved("settings:app-version",{version:APP_VERSION});
      return;
    }
    if(remote>APP_VERSION) showUpdateBanner();
  }catch(e){console.error("Version check failed:",e);}
}

function showUpdateBanner(){
  if(document.getElementById("update-banner")) return;
  const bar=document.createElement("div");
  bar.id="update-banner";
  bar.innerHTML=`<span>A newer version of this app is available — refresh to get the latest changes.</span>`;
  const btn=document.createElement("button");
  btn.textContent="Refresh now";
  btn.onclick=()=>location.reload();
  bar.appendChild(btn);
  document.body.appendChild(bar);
}

renderSidebar();
renderTeacher();
updateSeatingTabState();
syncAppVersion();
setInterval(syncAppVersion,3*60*1000); // re-check every 3 min in case a tab is left open all day
