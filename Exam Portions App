<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Test Portions Note</title>
<style>
  :root{
    --navy:#8C2F2F;--navy-dark:#4E1919;--gold:#C1502E;
    --bg:#F7EDE9;--card:#FFFBF9;--line:#E8D3CE;
    --text:#3A1F1F;--text-soft:#7A5A54;
    --owner:#A13B3B;--owner-light:#F3DCDC;--owner-border:#D9A0A0;
    --seating:#2E7D4F;--seating-light:#DCEEE3;--seating-border:#A9D3BB;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  body{font-family:-apple-system,Segoe UI,Roboto,Arial,sans-serif;background:var(--bg);color:var(--text);}

  /* ── Portal switcher ── */
  .portal-bar{
    display:flex;align-items:center;gap:0;
    background:var(--navy-dark);padding:10px 20px;
  }
  .portal-bar span{color:#D9A6A0;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;margin-right:12px;}
  .portal-tab{
    padding:7px 18px;border:none;border-radius:6px;font-size:13px;font-weight:600;cursor:pointer;
    background:transparent;color:#E3C0BA;
  }
  .portal-tab.active-teacher{background:var(--navy);color:#fff;}
  .portal-tab.active-owner{background:var(--owner);color:#fff;}
  .portal-tab.active-timetable{background:var(--gold);color:#fff;}
  .portal-tab.active-staff{background:var(--navy-dark);color:#fff;}
  .portal-tab.active-seating{background:var(--seating);color:#fff;}
  .portal-tab.tab-disabled{opacity:.45;cursor:not-allowed;}

  /* ── Layout ── */
  .app{display:flex;min-height:calc(100vh - 44px);}
  .sidebar{width:230px;background:var(--navy-dark);color:#fff;padding:20px 0;flex-shrink:0;}
  .sidebar-brand{display:flex;align-items:center;gap:10px;padding:0 20px 14px;}
  .brand-logo{width:38px;height:38px;object-fit:contain;flex-shrink:0;}
  .sidebar h1{font-size:15px;font-weight:700;margin:0 0 4px;font-family:Georgia,'Times New Roman',serif;}
  .sidebar .sub{font-size:11px;color:#E3C0BA;margin:0;}
  .group-label{font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:#D9A6A0;padding:10px 20px 6px;}
  .class-btn{
    display:block;width:100%;text-align:left;padding:9px 20px;
    background:none;border:none;border-left:3px solid transparent;
    color:#EED3CE;font-size:13.5px;cursor:pointer;
  }
  .class-btn:hover{background:rgba(255,255,255,0.06);}
  .class-btn.active{background:rgba(255,255,255,0.1);border-left:3px solid var(--gold);color:#fff;font-weight:600;}

  /* ── Main ── */
  .main{flex:1;padding:28px 40px;max-width:820px;}
  .main.main-wide{max-width:1180px;}
  .top-row{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px;flex-wrap:wrap;gap:12px;}
  .top-row h2{font-size:22px;color:var(--navy-dark);font-family:Georgia,'Times New Roman',serif;}
  .toggle{display:flex;background:var(--card);border:1px solid var(--line);border-radius:8px;overflow:hidden;}
  .toggle button{padding:9px 18px;border:none;background:none;font-size:13.5px;font-weight:600;color:var(--text-soft);cursor:pointer;}
  .toggle button.active{background:var(--navy);color:#fff;}
  .class-teacher-line{font-size:12.5px;color:var(--text-soft);margin:-10px 0 16px;}
  .class-teacher-line strong{color:var(--navy-dark);}
  .period-row{display:flex;align-items:center;gap:10px;margin-bottom:18px;}
  .period-row label{font-size:13px;color:var(--text-soft);font-weight:600;white-space:nowrap;}
  .period-row input{flex:1;max-width:260px;padding:8px 10px;border:1px solid var(--line);border-radius:6px;font-size:13.5px;}

  /* ── Teacher table ── */
  .card{background:var(--card);border:1px solid var(--line);border-radius:10px;overflow:hidden;}
  table{width:100%;border-collapse:collapse;}
  thead th{background:var(--navy);color:#fff;font-size:12.5px;text-transform:uppercase;letter-spacing:.03em;padding:12px 16px;text-align:left;}
  tbody td{padding:8px 16px;border-top:1px solid var(--line);font-size:14px;}
  tbody tr:first-child td{border-top:none;}
  .subject-cell{font-weight:600;color:var(--navy-dark);width:60%;display:flex;align-items:center;gap:6px;}
  .subject-cell input[type=text]{
    padding:18px 14px;border:1px solid var(--line);border-radius:6px;font-size:16px;font-weight:600;
    color:var(--navy-dark);background:#FCFBF8;flex:1;min-width:0;width:100%;min-height:24px;
  }
  .subject-cell input[type=text]:focus{outline:none;border-color:var(--navy);background:#fff;}
  .date-cell{width:190px;}
  .date-cell input[type=date]{
    width:100%;padding:15px 10px;border:1px solid var(--line);border-radius:6px;font-size:14.5px;background:#FCFBF8;color:var(--text);
  }
  .date-cell input[type=date]:focus{outline:none;border-color:var(--navy);background:#fff;}
  .position-cell textarea{
    width:100%;min-height:66px;padding:14px 14px;border:1px solid var(--line);border-radius:6px;
    font-size:15px;background:#FCFBF8;font-family:inherit;line-height:1.4;resize:vertical;
  }
  .position-cell textarea:focus{outline:none;border-color:var(--navy);background:#fff;}

  /* ── Owner portal ── */
  .owner-header{
    background:var(--owner-light);border:1px solid var(--owner-border);
    border-radius:10px;padding:14px 18px;margin-bottom:20px;
    display:flex;align-items:center;gap:10px;
  }
  .owner-header .icon{font-size:20px;}
  .owner-header p{font-size:13px;color:var(--owner);font-weight:600;}
  .owner-header span{font-size:12px;color:#7A2626;font-weight:400;}

  .owner-card{background:var(--card);border:1px solid var(--line);border-radius:10px;overflow:hidden;margin-bottom:20px;}
  .owner-card-head{
    background:var(--owner);color:#fff;padding:11px 16px;
    font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;
  }
  .owner-row{display:flex;align-items:center;padding:12px 16px;border-top:1px solid var(--line);gap:12px;flex-wrap:wrap;}
  .owner-row:first-of-type{border-top:none;}
  .owner-row .subj-name{font-weight:600;color:var(--navy-dark);font-size:14px;width:160px;flex-shrink:0;}


  /* ── Update banner ── */
  #update-banner{
    position:fixed;bottom:0;left:0;right:0;z-index:9999;
    background:var(--navy-dark);color:#fff;padding:12px 20px;
    display:flex;align-items:center;justify-content:center;gap:16px;flex-wrap:wrap;
    font-size:13.5px;box-shadow:0 -2px 10px rgba(0,0,0,.15);
  }
  #update-banner button{
    padding:7px 16px;border:none;border-radius:6px;background:var(--gold);color:#fff;
    font-size:13px;font-weight:700;cursor:pointer;
  }
  #update-banner button:hover{opacity:.9;}
  .owner-row .owner-subj-input{
    padding:16px 14px;border:1px solid var(--line);border-radius:6px;
    background:#FCFBF8;font-weight:600;color:var(--navy-dark);min-height:22px;font-size:14.5px;
  }
  .owner-row .owner-subj-input:focus{outline:none;border-color:var(--owner);background:#fff;}
  .owner-row input[type=date]{
    padding:7px 10px;border:1px solid var(--line);border-radius:6px;font-size:13.5px;background:#FCFBF8;
    color:var(--text);
  }
  .owner-row input[type=date]:focus{outline:none;border-color:var(--owner);background:#fff;}
  .owner-row .date-type{font-size:12px;color:var(--text-soft);font-weight:600;width:70px;flex-shrink:0;}
  .owner-row .portions-input{
    flex:1;min-width:180px;padding:7px 10px;border:1px solid var(--line);border-radius:6px;
    font-size:13.5px;background:#FCFBF8;font-family:inherit;line-height:1.4;resize:vertical;min-height:38px;
  }
  .owner-row .portions-input:focus{outline:none;border-color:var(--owner);background:#fff;}

  .settings-row,.label-row{display:flex;align-items:center;gap:10px;margin-bottom:14px;flex-wrap:wrap;}
  .settings-row label,.label-row label{font-size:13px;color:var(--text-soft);font-weight:600;white-space:nowrap;}
  .settings-row input,.label-row input{
    flex:1;min-width:220px;padding:8px 10px;border:1px solid var(--line);border-radius:6px;font-size:13.5px;
  }

  /* ── Actions ── */
  .add-subject-row{display:flex;align-items:center;gap:10px;margin-top:14px;}
  .add-subject-row input{flex:1;max-width:260px;padding:8px 10px;border:1px solid var(--line);border-radius:6px;font-size:13.5px;background:var(--card);}
  .add-subject-btn{padding:8px 16px;border:1px dashed var(--navy);border-radius:6px;background:none;color:var(--navy);font-size:13px;font-weight:600;cursor:pointer;white-space:nowrap;}
  .add-subject-btn:hover{background:var(--navy);color:#fff;border-style:solid;}
  .remove-subject-btn{background:none;border:none;color:var(--owner);font-size:15px;font-weight:700;cursor:pointer;margin-left:8px;line-height:1;padding:0 2px;}
  .remove-subject-btn:hover{color:#7A2626;}
  .actions{display:flex;align-items:center;gap:12px;margin-top:16px;}
  .save-btn{
    color:#fff;border:none;padding:10px 22px;border-radius:7px;
    font-size:13.5px;font-weight:600;cursor:pointer;
  }
  .save-btn.teacher-btn{background:var(--navy);}
  .save-btn.teacher-btn:hover{background:var(--navy-dark);}
  .save-btn.owner-btn{background:var(--owner);}
  .save-btn.owner-btn:hover{background:#6E2222;}
  .status{font-size:12.5px;color:#3F8F5F;opacity:0;transition:opacity .3s;}
  .status.show{opacity:1;}

  /* ── Panels ── */
  #teacher-view,#owner-view,#timetable-view,#staff-view,#seating-view{display:none;}
  #teacher-view.visible,#owner-view.visible,#timetable-view.visible,#staff-view.visible,#seating-view.visible{display:block;}

  /* ── Seating portal ── */
  .seating-header{
    background:var(--seating-light);border:1px solid var(--seating-border);
    border-radius:10px;padding:14px 18px;margin-bottom:20px;
    display:flex;align-items:center;gap:10px;
  }
  .seating-header .icon{font-size:20px;}
  .seating-header p{font-size:13px;color:var(--seating);font-weight:600;}
  .seating-header span{font-size:12px;color:#1F5A38;font-weight:400;}
  .save-btn.seating-btn{background:var(--seating);}
  .save-btn.seating-btn:hover{background:#215F3D;}
  .room-row{
    display:flex;align-items:center;gap:14px;padding:12px 16px;border-top:1px solid var(--line);flex-wrap:wrap;
  }
  .room-row:first-of-type{border-top:none;}
  .room-row.disabled{opacity:.5;}
  .room-check-label{
    display:flex;align-items:center;gap:9px;font-weight:600;color:var(--navy-dark);font-size:14px;
    width:230px;flex-shrink:0;cursor:pointer;
  }
  .room-check-label input[type=checkbox]{width:17px;height:17px;accent-color:var(--seating);cursor:pointer;}
  .room-cap-label{font-size:12px;color:var(--text-soft);font-weight:600;white-space:nowrap;}
  .room-row input[type=number]{
    width:90px;padding:7px 10px;border:1px solid var(--line);border-radius:6px;font-size:13.5px;background:#FCFBF8;
  }
  .room-row input[type=number]:focus{outline:none;border-color:var(--seating);background:#fff;}
  .seat-warning{font-size:12.5px;color:#B3261E;margin-top:6px;}
  .seat-note{font-size:12px;color:var(--text-soft);margin-top:4px;}
  .seat-sheet-table{width:100%;border-collapse:separate;border-spacing:0;min-width:700px;}
  .seat-sheet-table th,.seat-sheet-table td{border:1px solid var(--line);padding:18px 16px;vertical-align:top;font-size:13px;}
  .seat-sheet-table thead th{background:var(--seating);color:#fff;font-size:12.5px;text-transform:uppercase;letter-spacing:.04em;padding:16px;white-space:nowrap;}
  .seat-sheet-table td input[type=date]{width:140px;padding:9px 10px;border:1px solid var(--line);border-radius:6px;font-size:13.5px;}
  .seat-allrolls-input{width:100%;min-height:84px;padding:12px;border:1px solid var(--line);border-radius:6px;font-size:13px;font-family:inherit;line-height:1.6;resize:vertical;background:#FCFBF8;min-width:190px;}
  .seat-allrolls-input:focus{outline:none;border-color:var(--seating);background:#fff;}
  .seat-count{font-size:12px;color:var(--seating);font-weight:700;margin:10px 0;}
  .seat-teacher-input{width:100%;padding:10px;border:1px solid var(--line);border-radius:6px;font-size:13px;background:#FCFBF8;margin-top:6px;}
  .seat-teacher-input:focus{outline:none;border-color:var(--seating);background:#fff;}
  .seat-del-btn{background:none;border:none;color:#B3261E;font-size:18px;font-weight:700;cursor:pointer;padding:6px 10px;}
  .seat-room-toggle{display:inline-flex;align-items:center;gap:9px;font-weight:600;color:var(--navy-dark);font-size:14px;margin-right:28px;margin-bottom:6px;cursor:pointer;}
  .seat-room-toggle input{width:17px;height:17px;accent-color:var(--seating);cursor:pointer;}

  /* ── Timetable portal ── */
  .tt-sheet{background:#fff;border:1px solid var(--line);border-radius:10px;padding:6px;margin-bottom:16px;overflow-x:auto;}
  .tt-table{width:100%;border-collapse:collapse;background:#fff;table-layout:fixed;}
  .tt-table th,.tt-table td{border:1px solid #333;padding:9px 14px;font-size:13.5px;text-align:center;white-space:nowrap;}
  .tt-table thead th{background:#fff;color:var(--navy-dark);}
  .tt-table thead tr:nth-child(1) th{
    font-size:17px;font-weight:700;text-transform:none;letter-spacing:normal;padding:12px 14px 4px;
    font-family:Georgia,'Times New Roman',serif;
  }
  .tt-table thead tr:nth-child(2) th{
    font-size:14px;font-weight:600;color:var(--text-soft);text-transform:none;letter-spacing:normal;padding:2px 14px;
  }
  .tt-table thead tr:nth-child(3) th{
    font-size:15px;font-weight:700;text-transform:none;letter-spacing:normal;padding:4px 14px 12px;
  }
  .tt-table thead tr:last-child th{
    background:var(--navy);color:#fff;font-weight:700;text-transform:uppercase;letter-spacing:.03em;font-size:12.5px;
  }
  .tt-table td:nth-child(3){font-weight:600;color:var(--navy-dark);}
  .tt-table td:nth-child(4){text-align:left;white-space:normal;word-wrap:break-word;}
  .tt-empty{padding:24px;color:var(--text-soft);}
  .tt-table input[type=date],.tt-table input[type=text]{
    width:100%;min-width:90px;padding:6px 8px;border:1px solid var(--line);border-radius:5px;font-size:13px;background:#FCFBF8;
  }
  .tt-table td:nth-child(3) input[type=text]{min-width:110px;}
  .tt-table td:nth-child(4) input[type=text]{min-width:200px;}
  .tt-table input:focus{outline:none;border-color:var(--gold);background:#fff;}

  @media print{
    .portal-bar,.sidebar,.top-row,.actions,.modal-backdrop{display:none!important;}
    .app{display:block;}
    .main{padding:0;max-width:100%;}
    body{background:#fff;}
  }

  /* ── Password modal ── */
  .modal-backdrop{
    display:none;position:fixed;inset:0;background:rgba(22,58,89,0.55);
    align-items:center;justify-content:center;z-index:100;padding:20px;
  }
  .modal-backdrop.show{display:flex;}
  .modal-box{
    background:var(--card);border-radius:12px;padding:26px 26px 22px;
    width:100%;max-width:320px;box-shadow:0 12px 40px rgba(0,0,0,0.25);
  }
  .modal-box h3{font-size:16px;color:var(--navy-dark);margin-bottom:6px;}
  .modal-box p{font-size:12.5px;color:var(--text-soft);margin-bottom:14px;}
  .modal-box input{
    width:100%;padding:10px 12px;border:1px solid var(--line);border-radius:7px;
    font-size:14px;margin-bottom:8px;
  }
  .modal-box input:focus{outline:none;border-color:var(--owner);}
  .modal-error{font-size:12px;color:#B3261E;min-height:16px;margin-bottom:8px;}
  .modal-actions{display:flex;gap:10px;justify-content:flex-end;}
  .modal-actions button{
    padding:8px 16px;border-radius:7px;font-size:13px;font-weight:600;cursor:pointer;border:none;
  }
  .modal-cancel{background:none;color:var(--text-soft);}
  .modal-confirm{background:var(--owner);color:#fff;}
  .modal-confirm:hover{background:#6E2222;}

  @media(max-width:720px){
    .app{flex-direction:column;}
    .sidebar{width:100%;padding:14px 0;}
    .class-btn{display:inline-block;width:auto;}
    .main{padding:20px;}
    .owner-row{flex-direction:column;align-items:flex-start;}
    .owner-row .subj-name{width:auto;}
  }
</style>
</head>
<body>

<!-- Portal switcher -->
<div class="portal-bar">
  <span>Portal</span>
  <button class="portal-tab active-teacher" id="tab-teacher" onclick="switchPortal('teacher')">Teacher</button>
  <button class="portal-tab" id="tab-owner" onclick="switchPortal('owner')">Owner</button>
  <button class="portal-tab" id="tab-timetable" onclick="switchPortal('timetable')">Timetable</button>
  <button class="portal-tab" id="tab-staff" onclick="switchPortal('staff')">Staff Login</button>
  <button class="portal-tab" id="tab-seating" onclick="switchPortal('seating')">Seating</button>
</div>

<div class="app">
  <nav class="sidebar">
    <div class="sidebar-brand">
      <img src="data:image/png;base64," alt="VTC logo" class="brand-logo">
      <div>
        <h1>Test Portions Note</h1>
        <p class="sub">Weekly &amp; monthly subject portions</p>
      </div>
    </div>
    <div class="group-label">State board</div>
    <div id="sb-list"></div>
    <div class="group-label">CBSE</div>
    <div id="cbse-list"></div>
  </nav>

  <main class="main">

    <!-- ═══ TEACHER VIEW ═══ -->
    <div id="teacher-view" class="visible">
      <div class="top-row">
        <h2 id="class-title">SB VI B1</h2>
        <div class="toggle">
          <button id="btn-weekly" class="active" onclick="setType('weekly')">Weekly test</button>
          <button id="btn-monthly" onclick="setType('monthly')">Monthly test</button>
        </div>
      </div>
      <div class="class-teacher-line" id="class-teacher-info"></div>
      <div class="class-teacher-line" id="teacher-approval-info"></div>
      <div class="period-row">
        <label id="period-label">Week</label>
        <input type="text" id="period-input" placeholder="e.g. Week of 3 Aug">
      </div>
      <div class="card">
        <table>
          <thead><tr><th>Subject</th><th>Test date</th><th>Portions</th></tr></thead>
          <tbody id="subject-rows"></tbody>
        </table>
      </div>
      <div class="add-subject-row" id="add-subject-row" style="display:none;">
        <input type="text" id="new-subject-input" placeholder="e.g. Computer Science" onkeydown="if(event.key==='Enter'){event.preventDefault();addCustomSubject();}">
        <button class="add-subject-btn" onclick="addCustomSubject()">+ Add New Subject</button>
      </div>
      <div class="actions">
        <button class="save-btn teacher-btn" onclick="saveTeacher()">Save</button>
        <span class="status" id="t-status">Saved</span>
      </div>
    </div>

    <!-- ═══ OWNER VIEW ═══ -->
    <div id="owner-view">
      <div class="owner-header">
        <span class="icon">🔑</span>
        <div>
          <p>Owner portal — set test dates</p>
          <span>Dates you set here will appear in the Teacher view for each subject.</span>
        </div>
      </div>

      <div class="top-row">
        <h2 id="owner-class-title">SB VI B1</h2>
        <div class="toggle">
          <button id="obtn-weekly" class="active" onclick="setType('weekly')">Weekly test</button>
          <button id="obtn-monthly" onclick="setType('monthly')">Monthly test</button>
        </div>
      </div>

      <div class="settings-row">
        <label>Centre name</label>
        <input type="text" id="institute-name-input" placeholder="e.g. Vishnu Tuition Centre">
      </div>
      <div class="label-row">
        <label>Schedule title</label>
        <input type="text" id="test-label-input" placeholder="e.g. Weekly test-2 Schedule(10 marks)">
      </div>

      <div id="owner-cards"></div>

      <div class="actions">
        <button class="save-btn owner-btn" onclick="saveOwner()">Save dates</button>
        <span class="status" id="o-status">Dates saved</span>
      </div>

      <div class="owner-card" style="margin-top:20px;">
        <div class="owner-card-head">Overall confirmation</div>
        <div class="owner-row">
          <div class="subj-name" style="width:auto;">Status:</div>
          <span id="approval-status-text" style="font-weight:600;font-size:13.5px;">—</span>
        </div>
        <div class="actions" style="padding:12px 16px;">
          <button class="save-btn owner-btn" id="approve-btn" onclick="toggleApproval()">Approve schedule</button>
          <span class="status" id="approval-status-msg">Saved</span>
        </div>
      </div>

      <div class="owner-card" style="margin-top:24px;">
        <div class="owner-card-head">Change owner password</div>
        <div class="owner-row" style="flex-wrap:wrap;">
          <input type="password" id="pw-current-input" placeholder="Current password"
                 style="flex:1;min-width:160px;padding:8px 10px;border:1px solid var(--line);border-radius:6px;font-size:13.5px;">
          <input type="password" id="pw-new-input" placeholder="New password"
                 style="flex:1;min-width:160px;padding:8px 10px;border:1px solid var(--line);border-radius:6px;font-size:13.5px;">
          <button class="save-btn owner-btn" onclick="changeOwnerPassword()">Update password</button>
        </div>
        <div class="modal-error" id="pw-change-status" style="padding:0 16px 12px;"></div>
