<script>
const CLASSES = {
  sb:["SB VI B1","SB VII B1","SB VIII B1","SB IX B1","SB X B1","SB XI B1","SB XII B1"],
  cbse:["CBSE VI B1","CBSE VII B1","CBSE VIII B1","CBSE IX B1","CBSE X B1"]
};
const SUBJECTS_MAIN=["Tamil","English","Maths","Science","Social Science"];
const SUBJECTS_SR=["Physics","Chemistry","Maths","Biology"];
/* Weekly test has two Maths papers; Monthly test has only one.
   currentType is a global set by setType(), so this list adjusts itself
   whenever the Weekly/Monthly toggle is switched — no separate call needed. */
function subjectsFor(cls){
  const base=(cls.startsWith("SB XI")||cls.startsWith("SB XII"))?SUBJECTS_SR:SUBJECTS_MAIN;
  const list=base.slice();
  if(currentType==="weekly"){
    const idx=list.indexOf("Maths");
    if(idx!==-1) list.splice(idx+1,0,"Maths 2");
  }
  return list;
}

/* Order subjects by their exam date (earliest first) instead of the fixed
   Tamil/English/Maths… list order. e.g. if Social Science's date is set
   as the first exam, it now shows first everywhere — Teacher view, Owner
   view, and the Timetable. Subjects with no date set yet are left at the
   end, in their normal order, since there's nothing to sort them by. */
function orderSubjectsByDate(subjects,meta){
  const withIdx=subjects.map((s,i)=>({
    s,i,date:(meta.subjects[s]&&meta.subjects[s].date)||""
  }));
  withIdx.sort((a,b)=>{
    if(a.date&&b.date) return a.date.localeCompare(b.date);
    if(a.date) return -1;
    if(b.date) return 1;
    return a.i-b.i;
  });
  return withIdx.map(x=>x.s);
}

/* ── Custom subjects (Teacher-added, per class) ──
   Only these classes get the "+ Add New Subject" control. Custom
   subjects are stored per class (shared across Weekly/Monthly) and
   merged into the fixed curriculum list everywhere subjectsFor() is used. */
const CUSTOM_SUBJECT_CLASSES=["SB X B1","SB XI B1","SB XII B1","CBSE X B1"];
function customSubjectsKey(cls){return`custom-subjects:${slug(cls)}`;}
async function getCustomSubjects(cls){
  if(!CUSTOM_SUBJECT_CLASSES.includes(cls)) return [];
  const saved=await getSaved(customSubjectsKey(cls));
  return (saved&&saved.subjects)||[];
}
async function allSubjectsFor(cls){
  return [...subjectsFor(cls),...(await getCustomSubjects(cls))];
}

async function addCustomSubject(){
  const input=document.getElementById("new-subject-input");
  const name=input.value.trim();
  if(!name) return;
  const key=customSubjectsKey(currentClass);
  const saved=await getSaved(key);
  const list=(saved&&saved.subjects)||[];
  if(list.some(s=>s.toLowerCase()===name.toLowerCase())||subjectsFor(currentClass).some(s=>s.toLowerCase()===name.toLowerCase())){
    input.value="";
    input.placeholder="That subject already exists";
    setTimeout(()=>{input.placeholder="e.g. Computer Science";},1800);
    return;
  }
  list.push(name);
  const res=await setSaved(key,{subjects:list});
  if(res){
    input.value="";
    renderTeacher();
  }
}
async function removeCustomSubject(subj){
  if(!confirm(`Remove "${subj}" from ${currentClass}? Any dates/portions already saved for it are kept, just hidden.`)) return;
  const key=customSubjectsKey(currentClass);
  const saved=await getSaved(key);
  const list=((saved&&saved.subjects)||[]).filter(s=>s!==subj);
  await setSaved(key,{subjects:list});
  renderTeacher();
}

