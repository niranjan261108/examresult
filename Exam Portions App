/* ── Storage helpers ── */
function slug(s){return s.replace(/\s+/g,"_");}
function tKey(){return`position:${slug(currentClass)}:${currentType}`;}
function oKey(){return`owner-dates:${slug(currentClass)}:${currentType}`;}
function oKeyFor(cls,type){return`owner-dates:${slug(cls)}:${type}`;}
function approvalKey(cls,type){return`approval:${slug(cls)}:${type}`;}

/* Subject renames used to work by changing the STORAGE KEY that the date
   and portions were kept under (e.g. "Tamil" -> "Tamil I"). But the subject
   list shown on screen is always rebuilt from the fixed base list, so on
   the next visit "Tamil I" was never looked up again — the data wasn't
   actually deleted, it was just orphaned under a key nothing pointed to
   anymore. Fix: the ORIGINAL subject name is now a permanent, unchanging
   key for date/portions storage. A rename only changes a separate
   "display label" for that same permanent key, so nothing can ever get
   orphaned by typing a new name into the box. */
function subjLabelsKey(cls){return`subject-labels:${slug(cls)}`;}
async function getSubjectLabels(cls){
  const saved=await getSaved(subjLabelsKey(cls));
  return (saved&&saved.labels)||{};
}
/* subjNameMap: {origId: typedDisplayName}. Only persists entries that are
   actually different from the permanent id, and removes any override that
   was typed back to match the original. */
async function saveSubjectLabelChanges(cls,subjNameMap){
  const current=await getSubjectLabels(cls);
  let changed=false;
  Object.keys(subjNameMap).forEach(orig=>{
    const typed=(subjNameMap[orig]||"").trim();
    if(typed&&typed!==orig){
      if(current[orig]!==typed){current[orig]=typed;changed=true;}
    }else if(current[orig]){
      delete current[orig];changed=true;
    }
  });
  if(changed) await setSaved(subjLabelsKey(cls),{labels:current});
  return current;
}

async function getSaved(key){
  if(!db)return null;
  try{
    await authReady;
    const doc=await db.collection("app_data").doc(key).get();
    return doc.exists?doc.data().value:null;
  }catch(e){console.error("Firestore read failed:",e);return null;}
}

async function setSaved(key,value){
  if(!db)return false;
  try{
    await authReady;
    await db.collection("app_data").doc(key).set({
      value,
      updatedAt:firebase.firestore.FieldValue.serverTimestamp()
    });
    return true;
  }catch(e){console.error("Firestore write failed:",e);return false;}
}

/* Owner data now stores {label, subjects:{subj:{date,portions}}}.
   Older saves were a flat {subj: dateString} — read those too. */
function normalizeOwnerData(saved){
  if(!saved) return {label:"",subjects:{}};
  if(saved.subjects) return {label:saved.label||"",subjects:saved.subjects};
  const subjects={};
  Object.keys(saved).forEach(k=>{subjects[k]={date:saved[k],portions:""};});
  return {label:"",subjects};
}

/* ── Teacher view ── */
async function renderTeacher(){
  document.getElementById("class-title").textContent=currentClass;
  document.getElementById("period-label").textContent=currentType==="weekly"?"Week":"Month";
  document.getElementById("period-input").placeholder=currentType==="weekly"?"e.g. Week of 3 Aug":"e.g. August";

  const saved=await getSaved(tKey());
  const ownerSaved=await getSaved(oKey());
  const meta=normalizeOwnerData(ownerSaved);
  const baseSubjects=subjectsFor(currentClass);
  const customSubjects=await getCustomSubjects(currentClass);
  const subjects=orderSubjectsByDate([...baseSubjects,...customSubjects],meta);

  const addRow=document.getElementById("add-subject-row");
  addRow.style.display=CUSTOM_SUBJECT_CLASSES.includes(currentClass)?"flex":"none";

  const [teachersStored,classTeachers,subjLabels]=await Promise.all([
    getSaved("settings:teachers"),
    getClassTeachers(),
    getSubjectLabels(currentClass)
  ]);
  const teachersList=(teachersStored&&teachersStored.teachers)||[];
  const ctId=classTeachers[slug(currentClass)]||"";
  const ct=teachersList.find(t=>t.id===ctId);
  const ctInfoEl=document.getElementById("class-teacher-info");
  ctInfoEl.textContent="Class Teacher: ";
  const ctStrong=document.createElement("strong");
  ctStrong.textContent=ct?ct.name:"Not assigned";
  ctInfoEl.appendChild(ctStrong);

  document.getElementById("period-input").value=saved&&saved.period?saved.period:"";

  const approvalSaved=await getSaved(approvalKey(currentClass,currentType));
  const apInfo=document.getElementById("teacher-approval-info");
  if(approvalSaved&&approvalSaved.approved){
    apInfo.textContent=approvalSaved.approvedAt?`✅ Owner approved this schedule on ${formatDate(approvalSaved.approvedAt)}`:"✅ Owner approved this schedule";
    apInfo.style.color="#2E7D4F";
  }else{
    apInfo.textContent="⏳ Not yet approved by owner";
    apInfo.style.color="";
  }

  const tbody=document.getElementById("subject-rows");
  tbody.innerHTML="";
  subjects.forEach(subj=>{
    const tr=document.createElement("tr");

    // Subject name — editable, same rename pattern as the Owner portal.
    const tdS=document.createElement("td");
    tdS.className="subject-cell";
    const nameInp=document.createElement("input");
    nameInp.type="text";
    nameInp.value=subjLabels[subj]||subj;
