async function saveTeacher(){
  const period=document.getElementById("period-input").value.trim();

  // Period is teacher-only, kept under its own key.
  await setSaved(tKey(),{period});

  // Merge the entered subject names/dates/portions into the shared owner
  // data so they show up in the Owner portal and Timetable too.
  const ownerSaved=await getSaved(oKey());
  const meta=normalizeOwnerData(ownerSaved);
  const subjects={};
  Object.keys(meta.subjects).forEach(s=>{subjects[s]={...meta.subjects[s]};});

  // Build a map from the permanent subject id → the typed display name,
  // so a rename can be saved as a label WITHOUT moving the date/portions
  // to a new (and later unreachable) storage key.
  const subjNameMap={};
  document.querySelectorAll("#subject-rows .subject-cell input[type=text]").forEach(inp=>{
    subjNameMap[inp.dataset.origSubject]=inp.value.trim();
  });

  document.querySelectorAll("#subject-rows .date-cell input[type=date]").forEach(inp=>{
    const orig=inp.dataset.subject;
    if(!subjects[orig]) subjects[orig]={};
    subjects[orig].date=inp.value||"";
  });

  document.querySelectorAll("#subject-rows .position-cell textarea").forEach(inp=>{
    const orig=inp.dataset.subject;
    if(!subjects[orig]) subjects[orig]={};
    subjects[orig].portions=inp.value.trim();
  });

  try{
    const res=await setSaved(oKey(),{label:meta.label,subjects});
    if(!res)throw new Error("no result");
    await saveSubjectLabelChanges(currentClass,subjNameMap);
    flash("t-status");
  }catch(e){
    const el=document.getElementById("t-status");
    el.textContent="Could not save — try again";
    el.style.color="#B3261E";
    el.classList.add("show");
    setTimeout(()=>{el.classList.remove("show");el.textContent="Saved";el.style.color="";},2500);
  }
}

