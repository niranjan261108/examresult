<script type="module">
  import { createClient } from 'https://esm.sh/@supabase/supabase-js@2';
  const SUPABASE_URL = 'https://qeqpfnijcbqdipoesgqa.supabase.co';
  const SUPABASE_KEY = 'sb_publishable_HK1-UOtqcuELAfZ1N8gSXA_6mG_Ngl5';
  const supabase = createClient(SUPABASE_URL, SUPABASE_KEY);

function showToast(message, isError) {
    const container = document.getElementById('toast-container');
    const toast = document.createElement('div');
    toast.className = `px-5 py-3 rounded-lg shadow-lg font-label-md text-label-md flex items-center gap-2 ${isError ? 'bg-error-fail text-white' : 'bg-success-pass text-white'}`;
    toast.innerHTML = `<span class="material-symbols-outlined text-[18px]">${isError ? 'error' : 'check_circle'}</span> ${message}`;
    container.appendChild(toast);
    setTimeout(() => { toast.style.opacity = '0'; toast.style.transition = 'opacity .3s'; setTimeout(() => toast.remove(), 300); }, 2200);
  }


  // ---- view router ----
  // On this public page, only the search / countdown / result views ever
  // exist. Staff login and the Teacher/Owner dashboards live entirely in
  // a separate file (staff.html) -- they are never part of this page's
  // markup at all, not even hidden.
  function showView(id) {
    document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
    document.getElementById(id).classList.add('active');
  }
  document.querySelectorAll('.btn-back-to-search').forEach(b => b.addEventListener('click', () => showView('view-search')));

  // Checks the owner's timed lock (set from the staff portal). While
  // active, the "Staff Login" link is hidden on this page too, so
  // students aren't even shown a way to reach it.
  async function isEverythingLocked() {
    const { data: settings } = await supabase.from('system_settings').select('hide_staff_login_until').eq('id', 1).single();
    const until = settings?.hide_staff_login_until ? new Date(settings.hide_staff_login_until) : null;
    return !!(until && until.getTime() > Date.now());
  }
  async function applyStaffLoginVisibility() {
    const locked = await isEverythingLocked();
    const btn = document.getElementById('btn-goto-staff-login');
    if (btn) btn.classList.toggle('hidden', !!locked);
  }
  applyStaffLoginVisibility();
  setInterval(applyStaffLoginVisibility, 60 * 1000);

  // The Staff Login button takes staff to a completely separate page --
  // this page never contains any staff/teacher/owner markup or logic.
  document.getElementById('btn-goto-staff-login').addEventListener('click', async () => {
    if (await isEverythingLocked()) {
      showToast('Staff access is temporarily unavailable. Please try again later.', true);
      return;
    }
    window.location.href = 'staff.html';
  });

  // ---- search form ----
  document.getElementById('current-date').textContent = new Date().toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' });
  const form = document.getElementById('search-form');
  const errorBox = document.getElementById('search-error');
  const submitBtn = document.getElementById('search-submit');
  const submitText = document.getElementById('search-submit-text');

  function setLoading(loading) {
    submitBtn.disabled = loading;
    submitText.textContent = loading ? 'Searching...' : 'VIEW RESULT';
  }

  function showError(msg) {
    errorBox.textContent = msg;
    errorBox.classList.remove('hidden');
  }
  function hideError() {
    errorBox.classList.add('hidden');
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideError();
    const roll = document.getElementById('rollNumber').value.trim();
    const dob = document.getElementById('dob').value;
    if (!roll || !dob) return;

    setLoading(true);
    try {
      const { data, error } = await supabase.rpc('get_student_result', { p_roll: roll, p_dob: dob });
      setLoading(false);

      if (error) {
        showError('Something went wrong. Please try again in a moment.');
        console.error(error);
        return;
      }

      if (data && data.error === 'NOT_FOUND') {
        showError('No student found with that roll number and date of birth. Please check and try again.');
        return;
      }
      if (data && data.error === 'END_EXAM_RESULT_ACTIVE') {
        showCountdownScreen('END_EXAM_RESULT_ACTIVE');
        return;
      }
      if (data && data.error === 'NOT_PUBLISHED') {
        showCountdownScreen('NOT_PUBLISHED');
        return;
      }

      renderResult(data);
      showView('view-result');
    } catch (err) {
      setLoading(false);
      showError('Could not reach the server. Please check your connection and try again.');
      console.error(err);
    }
  });

  function showCountdownScreen(reason) {
    const icon = document.getElementById('countdown-icon');
    const title = document.getElementById('countdown-title');
    const message = document.getElementById('countdown-message');
    if (reason === 'END_EXAM_RESULT_ACTIVE') {
      icon.textContent = 'lock';
      title.textContent = 'RESULT ACCESS TEMPORARILY UNAVAILABLE';
      message.textContent = 'Please contact the tuition centre for more information.';
    } else {
      icon.textContent = 'hourglass_top';
      title.textContent = 'RESULTS NOT YET PUBLISHED';
      message.textContent = 'Your result has not been published yet. Please check back later.';
    }
    showView('view-countdown');
  }

  function renderResult(data) {
    document.getElementById('r-name').textContent = data.student.name;
    document.getElementById('r-roll').textContent = data.student.roll_number;
    document.getElementById('r-class').textContent = data.student.class;
    document.getElementById('r-exam').textContent = data.examination.name;
    document.getElementById('r-year').textContent = data.examination.academic_year;

    const subjects = data.subjects || [];
    const tbody = document.getElementById('r-subjects-body');
    tbody.innerHTML = '';
    let totalObtained = 0, totalMax = 0, overallPass = true;

    subjects.forEach((s, i) => {
      totalObtained += Number(s.obtained_marks);
      totalMax += Number(s.max_marks);
      if (s.status === 'FAIL') overallPass = false;

      const isFail = s.status === 'FAIL';
      const tr = document.createElement('tr');
      tr.className = `border-b border-border-subtle transition-colors ${isFail ? 'bg-error-container/10 hover:bg-error-container/20' : (i % 2 ? 'bg-surface' : '') + ' hover:bg-surface-alt'}`;
      tr.innerHTML = `
        <td class="py-3 px-4 font-body-md text-body-md font-medium ${isFail ? 'text-error-fail' : 'text-primary'}">${s.subject}</td>
        <td class="py-3 px-4 text-center text-on-surface-variant">${s.max_marks}</td>
        <td class="py-3 px-4 text-center text-on-surface-variant">${s.pass_marks}</td>
        <td class="py-3 px-4 text-center font-bold ${isFail ? 'text-error-fail' : 'text-primary'}">${s.obtained_marks}</td>
        <td class="py-3 px-4 text-center">
          <span class="inline-flex items-center justify-center px-2 py-1 rounded font-label-sm text-label-sm uppercase ${isFail ? 'bg-error-container text-error-fail font-bold border border-error-fail/30' : 'bg-secondary-fixed text-on-secondary-fixed'}">${s.status}</span>
        </td>`;
      tbody.appendChild(tr);
    });

    document.getElementById('r-total').textContent = totalObtained;
    document.getElementById('r-total-max').textContent = totalMax;
    const pct = totalMax > 0 ? (totalObtained / totalMax * 100).toFixed(2) : '0.00';
    document.getElementById('r-percentage').textContent = pct + '%';

    const overallBox = document.getElementById('r-overall-box');
    const overallLabel = document.getElementById('r-overall-label');
    const overall = document.getElementById('r-overall');
    if (overallPass && subjects.length > 0) {
      overallBox.className = 'flex flex-col items-center justify-center p-6 rounded border bg-secondary-fixed/20 border-success-pass/30';
      overallLabel.className = 'font-label-sm text-label-sm uppercase mb-1 text-success-pass';
      overall.className = 'font-headline-lg text-headline-lg font-bold text-success-pass';
      overall.textContent = 'PASS';
    } else {
      overallBox.className = 'flex flex-col items-center justify-center p-6 rounded border bg-error-container/20 border-error-fail/30';
      overallLabel.className = 'font-label-sm text-label-sm uppercase mb-1 text-error-fail';
