  document.getElementById('btn-close-bulk-add').addEventListener('click', () => bulkAddModal.classList.add('hidden'));

  document.getElementById('bulk-add-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const errBox = document.getElementById('bulk-add-error');
    const resultBox = document.getElementById('bulk-add-result');
    errBox.classList.add('hidden');
    resultBox.classList.add('hidden');

    const classId = document.getElementById('bulk-add-class').value;
    const year = document.getElementById('bulk-add-year').value.trim();
    const subjectIds = [...document.querySelectorAll('.bulk-subject-check:checked')].map(cb => cb.value);
    const lines = document.getElementById('bulk-add-textarea').value.split('\n').map(l => l.trim()).filter(Boolean);

    if (lines.length === 0) { errBox.textContent = 'Please paste at least one student.'; errBox.classList.remove('hidden'); return; }

    let added = 0, skipped = 0, malformed = 0;
    for (const line of lines) {
      const parts = line.split(',').map(p => p.trim());
      if (parts.length < 3) { malformed++; continue; }
      const [name, roll, dob] = parts;
      if (!name || !roll || !dob) { malformed++; continue; }

      const { data: inserted, error } = await supabase
        .from('students')
        .insert({ full_name: name, roll_number: roll, date_of_birth: dob, academic_year: year, class_id: classId, created_by: currentTeacherId })
        .select()
        .single();

      if (error) { skipped++; continue; }
      added++;
      if (subjectIds.length > 0) {
        await supabase.from('student_subjects').insert(subjectIds.map(sid => ({ student_id: inserted.id, subject_id: sid })));
      }
    }

    resultBox.textContent = `Added ${added} student(s).` + (skipped ? ` Skipped ${skipped} (likely duplicate roll numbers).` : '') + (malformed ? ` ${malformed} line(s) were malformed and skipped.` : '');
    resultBox.classList.remove('hidden');
    await loadStudentList();
  });

  // ---- marks entry ----
  function setupMarksClassSubjectFilters() {
    const classSelect = document.getElementById('marks-class-select');
    const subjectSelect = document.getElementById('marks-subject-select');
    const uniqueClasses = [...new Map(teacherAssignments.map(a => [a.class_id, a.class_name])).entries()];
    classSelect.innerHTML = uniqueClasses.map(([id, name]) => `<option value="${id}">${name}</option>`).join('');

