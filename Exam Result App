  function renderExamSubjectInputs() {
    const container = document.getElementById('new-exam-subjects');
    const classId = document.getElementById('new-exam-class').value;
    const subjectsToShow = examModalContext === 'teacher'
      ? teacherAssignments.filter(a => String(a.class_id) === String(classId)).map(a => ({ id: a.subject_id, name: a.subject_name }))
