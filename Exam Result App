  // ---- Approvals tab ----
  async function loadApprovals() {
    const { data: pending } = await supabase
      .from('marks')
      .select('id, obtained_marks, entered_by, students(full_name, classes(display_name)), subjects(name), examinations(name)')
      .eq('status', 'PENDING_APPROVAL');

    const tbody = document.getElementById('approvals-body');
    const emptyMsg = document.getElementById('approvals-empty');
    tbody.innerHTML = '';

    if (!pending || pending.length === 0) { emptyMsg.classList.remove('hidden'); return; }
    emptyMsg.classList.add('hidden');

    pending.forEach(m => {
      const tr = document.createElement('tr');
      tr.innerHTML = `
        <td class="py-2 px-4">${m.students?.full_name || ''}</td>
        <td class="py-2 px-4">${m.students?.classes?.display_name || ''}</td>
        <td class="py-2 px-4">${m.subjects?.name || ''}</td>
        <td class="py-2 px-4">${m.examinations?.name || ''}</td>
        <td class="py-2 px-4 text-center font-bold">${m.obtained_marks}</td>
        <td class="py-2 px-4 text-right">
          <button class="btn-approve px-3 py-1.5 rounded bg-secondary-fixed text-on-secondary-fixed font-label-md text-label-md mr-2" data-id="${m.id}">Approve</button>
          <button class="btn-reject px-3 py-1.5 rounded bg-error-container text-error-fail font-label-md text-label-md" data-id="${m.id}">Reject</button>
        </td>`;
      tbody.appendChild(tr);
    });

    tbody.querySelectorAll('.btn-approve').forEach(b => b.addEventListener('click', async () => {
      const row = pending.find(m => String(m.id) === b.dataset.id);
      await supabase.from('marks').update({ status: 'APPROVED', reviewed_by: (await supabase.auth.getUser()).data.user.id }).eq('id', b.dataset.id);
      if (row) await notify(row.entered_by, `Marks approved: ${row.subjects?.name} — ${row.students?.full_name} (${row.examinations?.name})`);
      showToast('Marks approved.');
      await loadApprovals();
    }));
    tbody.querySelectorAll('.btn-reject').forEach(b => b.addEventListener('click', async () => {
      const reason = prompt('Reason for rejection (shown to the teacher):') || 'No reason given';
      const row = pending.find(m => String(m.id) === b.dataset.id);
      await supabase.from('marks').update({ status: 'REJECTED', rejection_reason: reason, reviewed_by: (await supabase.auth.getUser()).data.user.id }).eq('id', b.dataset.id);
      if (row) await notify(row.entered_by, `Marks rejected: ${row.subjects?.name} — ${row.students?.full_name} (${row.examinations?.name}). Reason: ${reason}`);
      showToast('Marks rejected.', true);
      await loadApprovals();
    }));
  }

  // ---- Publish tab ----
  async function loadPublishCards() {
    const { data: pubs } = await supabase
      .from('result_publications')
      .select('id, examination_id, publish_at, status, examinations(name, academic_year, classes(display_name))')
      .order('publish_at', { ascending: false });

    // check how many APPROVED marks exist for each examination, so we can warn/block
    // publishing exams that have no approved marks yet.
    const examIds = [...new Set((pubs || []).map(p => p.examination_id))];
    const approvedCounts = {};
    if (examIds.length > 0) {
      const { data: markRows } = await supabase
        .from('marks')
        .select('examination_id, status')
        .in('examination_id', examIds);
      (markRows || []).forEach(m => {
        if (!approvedCounts[m.examination_id]) approvedCounts[m.examination_id] = { approved: 0, other: 0 };
        if (m.status === 'APPROVED') approvedCounts[m.examination_id].approved++;
        else approvedCounts[m.examination_id].other++;
      });
    }

    const container = document.getElementById('publish-cards');
    container.innerHTML = (pubs || []).map(p => {
      const counts = approvedCounts[p.examination_id] || { approved: 0, other: 0 };
      const hasNoApproved = counts.approved === 0;
      const warningBanner = hasNoApproved
        ? `<div class="mb-3 px-3 py-2 rounded bg-error-container text-error-fail font-body-sm text-body-sm flex items-center gap-2">
             <span class="material-symbols-outlined text-[18px]">warning</span>
             No approved marks yet${counts.other > 0 ? ` (${counts.other} pending/rejected)` : ''} — students will see an empty result.
           </div>`
        : `<p class="font-body-sm text-body-sm text-success-pass mb-3">${counts.approved} approved mark${counts.approved === 1 ? '' : 's'} entered.</p>`;
      return `
      <div class="bg-surface-container-lowest border border-border-subtle rounded-lg p-5">
        <h3 class="font-headline-md text-headline-md text-primary mb-1">${p.examinations?.name || ''}</h3>
        <p class="font-body-sm text-body-sm text-on-surface-variant mb-2">${p.examinations?.classes?.display_name || ''} · ${p.examinations?.academic_year || ''}</p>
        <p class="font-body-sm text-body-sm mb-3">Scheduled: ${new Date(p.publish_at).toLocaleString('en-IN')}</p>
        <span class="inline-block px-2 py-1 rounded text-xs font-bold uppercase mb-3 ${p.status === 'PUBLISHED' ? 'bg-secondary-fixed text-on-secondary-fixed' : p.status === 'UNPUBLISHED' ? 'bg-error-container text-error-fail' : 'bg-warning-pending/20 text-warning-pending'}">${p.status}</span>
        ${warningBanner}
        <div class="flex gap-2 flex-wrap">
          <button class="btn-reschedule px-3 py-1.5 rounded border border-border-subtle font-label-md text-label-md" data-id="${p.examination_id}">Reschedule</button>
          <button class="btn-publish-now px-3 py-1.5 rounded font-label-md text-label-md ${hasNoApproved ? 'bg-surface-container-highest text-on-surface-variant cursor-not-allowed' : 'bg-primary-container text-on-primary'}" data-id="${p.id}" ${hasNoApproved ? 'disabled' : ''}>Publish Now</button>
          <button class="btn-unpublish px-3 py-1.5 rounded bg-error-container text-error-fail font-label-md text-label-md" data-id="${p.id}">Unpublish</button>
        </div>
      </div>`;
    }).join('') || '<p class="font-body-sm text-body-sm text-on-surface-variant">No examinations yet.</p>';

    container.querySelectorAll('.btn-reschedule').forEach(b => b.addEventListener('click', () => {
      document.getElementById('schedule-exam-id').value = b.dataset.id;
      document.getElementById('schedule-publish-modal').classList.remove('hidden');
    }));
    container.querySelectorAll('.btn-publish-now').forEach(b => b.addEventListener('click', async () => {
      const pub = pubs.find(p => String(p.id) === b.dataset.id);
      const counts = pub ? (approvedCounts[pub.examination_id] || { approved: 0, other: 0 }) : { approved: 0, other: 0 };
      if (counts.approved === 0) {
        showToast('Cannot publish: no approved marks for this exam yet.', true);
        return;
      }
      await supabase.from('result_publications').update({ status: 'PUBLISHED', publish_at: 'now' }).eq('id', b.dataset.id);
      if (pub) {
        const { data: assignedTeachers } = await supabase.from('teacher_assignments').select('teacher_id').eq('class_id', (await supabase.from('examinations').select('class_id').eq('id', pub.examination_id).single()).data?.class_id);
        const uniqueTeacherIds = [...new Set((assignedTeachers || []).map(a => a.teacher_id))];
        for (const tid of uniqueTeacherIds) await notify(tid, `Result published: ${pub.examinations?.name}`);
      }
      showToast('Result published successfully.');
      await loadPublishCards();
    }));
    container.querySelectorAll('.btn-unpublish').forEach(b => b.addEventListener('click', async () => {
      await supabase.from('result_publications').update({ status: 'UNPUBLISHED' }).eq('id', b.dataset.id);
      await loadPublishCards();
    }));
  }
  document.getElementById('btn-close-schedule').addEventListener('click', () => document.getElementById('schedule-publish-modal').classList.add('hidden'));
  document.getElementById('schedule-publish-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const examId = document.getElementById('schedule-exam-id').value;
    const when = document.getElementById('schedule-datetime').value;
    await supabase.from('result_publications').update({ publish_at: new Date(when).toISOString(), status: 'SCHEDULED' }).eq('examination_id', examId);
    document.getElementById('schedule-publish-modal').classList.add('hidden');
    await loadPublishCards();
  });

