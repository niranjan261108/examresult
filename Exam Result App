  async function loadEndExamStatus() {
    const { data: settings } = await supabase.from('system_settings').select('end_exam_result_active').eq('id', 1).single();
    const active = settings?.end_exam_result_active || false;
    const icon = document.getElementById('endexam-icon');
    const status = document.getElementById('endexam-status');
    const btn = document.getElementById('btn-toggle-endexam');
    if (active) {
      icon.textContent = 'lock'; icon.className = 'material-symbols-outlined text-[48px] mb-4 block text-error-fail';
      status.textContent = 'CURRENTLY ACTIVE — staff login disabled'; status.className = 'font-label-md text-label-md mb-6 uppercase text-error-fail';
      btn.textContent = 'DEACTIVATE'; btn.className = 'px-6 py-3 rounded-lg font-label-md text-label-md active:scale-95 bg-surface-container-highest text-on-surface border border-border-subtle';
    } else {
      icon.textContent = 'lock_open'; icon.className = 'material-symbols-outlined text-[48px] mb-4 block text-success-pass';
      status.textContent = 'CURRENTLY INACTIVE — normal access'; status.className = 'font-label-md text-label-md mb-6 uppercase text-success-pass';
      btn.textContent = 'ACTIVATE'; btn.className = 'px-6 py-3 rounded-lg font-label-md text-label-md active:scale-95 bg-error-fail text-white';
    }
    btn.onclick = async () => {
      const confirmMsg = active ? 'Deactivate END EXAM RESULT and restore normal staff access?' : 'Activate END EXAM RESULT? This disables staff login for everyone except you.';
      if (!confirm(confirmMsg)) return;
      const { data: { user } } = await supabase.auth.getUser();
      await supabase.from('system_settings').update({ end_exam_result_active: !active, updated_by: user.id }).eq('id', 1);
      await loadEndExamStatus();
    };

    await loadHideStaffLoginStatus();
  }

  // ---- HIDE STAFF LOGIN (timed) ----
  // Note: if a lock is currently active, the owner can never actually be
  // looking at this panel (routeAfterLogin blocks entry, and the watchdog
  // kicks out anyone already inside). So this always renders the "ready
  // to set a new lock" state — there is nothing to show for an active
  // lock here, and no cancel action, by design.
  async function loadHideStaffLoginStatus() {
    const icon = document.getElementById('hidelogin-icon');
    const status = document.getElementById('hidelogin-status');
    icon.textContent = 'visibility'; icon.className = 'material-symbols-outlined text-[48px] mb-4 block text-success-pass';
    status.textContent = 'CURRENTLY VISIBLE TO STUDENTS'; status.className = 'font-label-md text-label-md mb-6 uppercase text-success-pass';

    document.querySelectorAll('.hidelogin-duration-btn').forEach(b => {
      b.onclick = async () => {
        const minutes = Number(b.dataset.minutes);
        await setHideStaffLoginFor(minutes);
      };
    });

    document.getElementById('btn-hidelogin-custom').onclick = async () => {
      const minutes = Number(document.getElementById('hidelogin-custom-minutes').value);
      if (!minutes || minutes <= 0) {
        showToast('Enter a valid number of minutes.', true);
        return;
      }
      await setHideStaffLoginFor(minutes);
    };
  }

  async function setHideStaffLoginFor(minutes) {
    const untilDate = new Date(Date.now() + minutes * 60 * 1000);
    if (!confirm(`Lock staff login and the Teacher/Owner panels for ${minutes} minutes, until ${untilDate.toLocaleString('en-IN')}? Nobody, including you, can undo this early — you'll be signed out shortly after confirming.`)) return;
    const { data: { user } } = await supabase.auth.getUser();
    await supabase.from('system_settings').update({ hide_staff_login_until: untilDate.toISOString(), updated_by: user.id }).eq('id', 1);
    showToast('Staff access locked. You will be signed out shortly.');
    // no need to call loadHideStaffLoginStatus() — the watchdog will sign
    // this owner out within ~15s once the lock takes effect.
  }


  // Watchdog: once inside the teacher or owner dashboard, keep checking
  // in the background. If the owner turns on "Hide Staff Login" while
  // someone is already sitting inside a panel (Add Student, Add Teacher,
  // etc. still open), this signs them out and kicks them back to the
  // search page within the check interval — closing the gap where an
  // already-open session could keep working after the lock starts.
  let lockWatchdogInterval = null;
  function startLockWatchdog() {
    if (lockWatchdogInterval) return; // already running
    lockWatchdogInterval = setInterval(async () => {
      if (await isEverythingLocked()) {
        clearInterval(lockWatchdogInterval);
        lockWatchdogInterval = null;
        await supabase.auth.signOut();
        resetTeacherState();
        unmountStaffPortal();
        showToast('Staff access has been locked by the owner.', true);
        showView('view-search');
      }
    }, 15 * 1000);
  }

  // ---- Genuine staff-portal isolation ----
  // The Teacher and Owner dashboard <section> elements are detached from
  // the document right here, after every button/form inside them has
  // already had its event listeners attached above (detaching a node does
  // not remove listeners bound to it or its children — it just takes it
  // out of the page). From this point on, an unauthenticated visitor's
  // DOM contains no staff markup at all — not hidden with CSS, genuinely
  // absent — until a real successful Supabase login calls
  // mountStaffPortal(), which re-inserts the correct one into
  // #staff-portal-mount. unmountStaffPortal() reverses this on logout,
  // on a lock, or if the watchdog signs someone out.
  let teacherDashboardNode = document.getElementById('view-teacher-dashboard');
  let ownerDashboardNode = document.getElementById('view-owner-dashboard');
  if (teacherDashboardNode) teacherDashboardNode.remove();
  if (ownerDashboardNode) ownerDashboardNode.remove();

  function mountStaffPortal(role) {
    const mount = document.getElementById('staff-portal-mount');
    if (teacherDashboardNode && teacherDashboardNode.parentNode) teacherDashboardNode.remove();
    if (ownerDashboardNode && ownerDashboardNode.parentNode) ownerDashboardNode.remove();
    const node = role === 'owner' ? ownerDashboardNode : teacherDashboardNode;
    if (node) mount.appendChild(node);
  }

  function unmountStaffPortal() {
    if (teacherDashboardNode && teacherDashboardNode.parentNode) teacherDashboardNode.remove();
    if (ownerDashboardNode && ownerDashboardNode.parentNode) ownerDashboardNode.remove();
  }

  // NOTE: we deliberately do NOT auto-route to the teacher/owner dashboard
  // on page load, even if a staff session is still saved in this browser.
  // The public link must always land on the student search page first
  // (see the "Staff Login" button handler above, which routes staff to
  // their dashboard only when they explicitly click it).
</script>
