  document.getElementById('btn-close-add-teacher').addEventListener('click', () => document.getElementById('add-teacher-modal').classList.add('hidden'));

  document.getElementById('add-teacher-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const errBox = document.getElementById('add-teacher-error');
    const noteBox = document.getElementById('add-teacher-note');
    errBox.classList.add('hidden');
    noteBox.classList.add('hidden');

    if (await isEverythingLocked()) {
      showToast('Staff access is temporarily locked. Please try again later.', true);
      return;
    }

    const name = document.getElementById('new-teacher-name').value.trim();
    const email = document.getElementById('new-teacher-email').value.trim();
    const password = document.getElementById('new-teacher-password').value;

    // isolated client so this signUp never touches the owner's active session
    const tempClient = createClient(SUPABASE_URL, SUPABASE_KEY, {
      auth: { persistSession: false, autoRefreshToken: false, storageKey: 'temp-teacher-creation-' + Date.now() }
    });

    const { data: signUpData, error: signUpError } = await tempClient.auth.signUp({ email, password });
    if (signUpError) {
      errBox.textContent = 'Could not create login: ' + signUpError.message;
      errBox.classList.remove('hidden');
      return;
    }

    const newUserId = signUpData.user?.id;
    if (!newUserId) {
      errBox.textContent = 'Account creation may require email confirmation — check your Supabase Auth settings (disable "Confirm email" for staff accounts to work immediately).';
      errBox.classList.remove('hidden');
      return;
    }

    const { error: profileError } = await supabase.from('profiles').insert({ id: newUserId, full_name: name, role: 'teacher', email });
    if (profileError) {
      errBox.textContent = 'Login created, but profile setup failed: ' + profileError.message;
      errBox.classList.remove('hidden');
      return;
