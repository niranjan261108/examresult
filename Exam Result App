  // ---- Add Teacher (client-side signUp via an isolated temp client so it doesn't disturb the owner's session) ----
  document.getElementById('btn-open-add-teacher').addEventListener('click', () => {
    document.getElementById('add-teacher-form').reset();
    document.getElementById('add-teacher-error').classList.add('hidden');
    document.getElementById('add-teacher-note').classList.add('hidden');
    document.getElementById('add-teacher-modal').classList.remove('hidden');
