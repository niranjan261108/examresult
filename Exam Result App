  async function loadExamsForMarks() {
    const classIds = [...new Set(teacherAssignments.map(a => a.class_id))];
    const examSelect = document.getElementById('marks-exam-select');
    const noExams = document.getElementById('marks-no-exams');
    const entryArea = document.getElementById('marks-entry-area');

    if (classIds.length === 0) { noExams.classList.remove('hidden'); return; }

    const { data: exams } = await supabase
      .from('examinations')
      .select('id, name, academic_year, class_id')
      .in('class_id', classIds)
      .order('created_at', { ascending: false });

    if (!exams || exams.length === 0) {
      noExams.classList.remove('hidden');
      entryArea.classList.add('hidden');
      return;
    }
    noExams.classList.add('hidden');
    examSelect.innerHTML = exams.map(e => `<option value="${e.id}" data-class="${e.class_id}">${e.name} (${e.academic_year})</option>`).join('');
