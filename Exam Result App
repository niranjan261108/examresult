  const bulkAddModal = document.getElementById('bulk-add-modal');
  document.getElementById('btn-open-bulk-add').addEventListener('click', () => {
    const classSelect = document.getElementById('bulk-add-class');
    const uniqueClasses = [...new Map(teacherAssignments.map(a => [a.class_id, a.class_name])).entries()];
    classSelect.innerHTML = uniqueClasses.map(([id, name]) => `<option value="${id}">${name}</option>`).join('');

    function renderBulkSubjects() {
      const subs = teacherAssignments.filter(a => String(a.class_id) === String(classSelect.value));
      document.getElementById('bulk-add-subjects').innerHTML = subs.map(a => `
        <label class="flex items-center gap-2 text-body-sm font-body-sm cursor-pointer">
          <input type="checkbox" class="bulk-subject-check rounded" value="${a.subject_id}" checked/> ${a.subject_name}
        </label>`).join('');
    }
    classSelect.onchange = renderBulkSubjects;
    renderBulkSubjects();

