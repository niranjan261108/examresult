  document.getElementById('add-student-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const errBox = document.getElementById('add-student-error');
    errBox.classList.add('hidden');

    if (await isEverythingLocked()) {
      showToast('Staff access is temporarily locked. Please try again later.', true);
      return;
    }

    const editId = document.getElementById('edit-student-id').value;
    const name = document.getElementById('new-student-name').value.trim();
    const roll = document.getElementById('new-student-roll').value.trim();
    const dob = document.getElementById('new-student-dob').value;
    const year = document.getElementById('new-student-year').value.trim();
    const classId = document.getElementById('new-student-class').value;
    const subjectIds = [...document.querySelectorAll('#new-student-subjects input:checked')].map(cb => cb.value);

    if (editId) {
      const { error: updateError } = await supabase.from('students')
        .update({ full_name: name, roll_number: roll, date_of_birth: dob, academic_year: year, class_id: classId })
        .eq('id', editId);
      if (updateError) {
        errBox.textContent = 'Could not update student: ' + updateError.message;
        errBox.classList.remove('hidden');
        return;
      }
      // replace only this teacher's subject rows for this student
      const mySubjectIds = teacherAssignments.map(a => a.subject_id);
      await supabase.from('student_subjects').delete().eq('student_id', editId).in('subject_id', mySubjectIds);
      if (subjectIds.length > 0) {
        await supabase.from('student_subjects').insert(subjectIds.map(sid => ({ student_id: editId, subject_id: sid })));
      }
      addStudentModal.classList.add('hidden');
      await loadStudentList();
      return;
    }

    const { data: inserted, error: insertError } = await supabase
      .from('students')
      .insert({ full_name: name, roll_number: roll, date_of_birth: dob, academic_year: year, class_id: classId, created_by: currentTeacherId })
      .select()
      .single();

    if (insertError) {
      errBox.textContent = insertError.message.includes('duplicate') ? 'A student with this roll number already exists.' : 'Could not save student: ' + insertError.message;
      errBox.classList.remove('hidden');
      return;
    }

    if (subjectIds.length > 0) {
      const rows = subjectIds.map(sid => ({ student_id: inserted.id, subject_id: sid }));
      await supabase.from('student_subjects').insert(rows);
    }

    addStudentModal.classList.add('hidden');
    await loadStudentList();
  });

