  async function loadMarksEntryTable() {
    const examSelect = document.getElementById('marks-exam-select');
    const subjectSelect = document.getElementById('marks-subject-select');
    const entryArea = document.getElementById('marks-entry-area');
    const tbody = document.getElementById('marks-entry-body');
    const saveMsg = document.getElementById('marks-save-message');
    saveMsg.textContent = '';

    const examId = examSelect.value;
    const classId = document.getElementById('marks-class-select').value;
    const subjectId = subjectSelect.value;
    if (!examId || !classId || !subjectId) { entryArea.classList.add('hidden'); return; }

    const { data: examSubject } = await supabase
      .from('exam_subjects')
      .select('max_marks, pass_marks')
      .eq('examination_id', examId)
      .eq('subject_id', subjectId)
      .maybeSingle();

    if (!examSubject) {
      entryArea.classList.add('hidden');
      saveMsg.textContent = 'This subject has not been configured for this examination yet — ask the owner to set max/pass marks.';
      return;
    }

    const { data: students } = await supabase
      .from('students')
      .select('id, roll_number, full_name, student_subjects!inner(subject_id)')
      .eq('class_id', classId)
      .eq('student_subjects.subject_id', subjectId)
      .order('full_name');

    const { data: existingMarks } = await supabase
      .from('marks')
      .select('student_id, obtained_marks, status, rejection_reason')
      .eq('examination_id', examId)
      .eq('subject_id', subjectId);
    const marksByStudent = Object.fromEntries((existingMarks || []).map(m => [m.student_id, m]));

    tbody.innerHTML = '';
    (students || []).forEach(s => {
      const existing = marksByStudent[s.id];
      const status = existing?.status || 'DRAFT';
      const locked = status === 'PENDING_APPROVAL' || status === 'APPROVED';
      const isExempt = status === 'EXEMPT';
      const tr = document.createElement('tr');
      tr.dataset.studentId = s.id;
      tr.innerHTML = `
        <td class="py-2 px-4 font-data-mono text-data-mono text-primary-container">${s.roll_number}</td>
        <td class="py-2 px-4">${s.full_name}</td>
        <td class="py-2 px-4 text-center text-on-surface-variant">${examSubject.max_marks}</td>
        <td class="py-2 px-4 text-center">
          <input type="number" min="0" max="${examSubject.max_marks}" class="marks-input w-24 text-center border border-border-subtle rounded py-1.5 px-2" value="${existing && !isExempt ? existing.obtained_marks : ''}" ${locked || isExempt ? 'disabled' : ''}/>
        </td>
        <td class="py-2 px-4 text-center">
          <input type="checkbox" class="not-appearing-check rounded" ${isExempt ? 'checked' : ''} ${locked ? 'disabled' : ''}/>
        </td>
        <td class="py-2 px-4 text-center">
          <span class="px-2 py-1 rounded text-xs font-bold uppercase ${statusBadgeClass(status)}">${status.replace('_',' ')}</span>
          ${status === 'REJECTED' && existing?.rejection_reason ? `<div class="text-xs text-error-fail mt-1">${existing.rejection_reason}</div>` : ''}
        </td>`;
      tbody.appendChild(tr);

      const checkbox = tr.querySelector('.not-appearing-check');
      const input = tr.querySelector('.marks-input');
      checkbox.addEventListener('change', () => {
        input.disabled = checkbox.checked;
        if (checkbox.checked) input.value = '';
      });
    });
    entryArea.classList.remove('hidden');
  }

  function statusBadgeClass(status) {
    switch (status) {
      case 'APPROVED': return 'bg-secondary-fixed text-on-secondary-fixed';
      case 'PENDING_APPROVAL': return 'bg-warning-pending/20 text-warning-pending';
      case 'REJECTED': return 'bg-error-container text-error-fail';
      case 'EXEMPT': return 'bg-surface-variant text-on-surface-variant';
      default: return 'bg-surface-container-highest text-on-surface-variant';
    }
  }

  async function saveMarks(newStatus) {
    const examId = document.getElementById('marks-exam-select').value;
    const subjectId = document.getElementById('marks-subject-select').value;
    const saveMsg = document.getElementById('marks-save-message');
    const rows = [...document.querySelectorAll('#marks-entry-body tr')];

    let errorCount = 0;
    for (const row of rows) {
      const input = row.querySelector('.marks-input');
      const exemptCheck = row.querySelector('.not-appearing-check');
      if (exemptCheck.disabled && !exemptCheck.checked) continue; // locked row, nothing to change
      const studentId = row.dataset.studentId;

      if (exemptCheck.checked) {
        const { error } = await supabase.from('marks').upsert({
          examination_id: examId, student_id: studentId, subject_id: subjectId,
          obtained_marks: 0, status: 'EXEMPT', entered_by: currentTeacherId
        }, { onConflict: 'examination_id,student_id,subject_id' });
        if (error) errorCount++;
        continue;
      }

      if (input.disabled || input.value === '') continue;
      const { error } = await supabase.from('marks').upsert({
        examination_id: examId,
        student_id: studentId,
        subject_id: subjectId,
        obtained_marks: Number(input.value),
        status: newStatus,
        entered_by: currentTeacherId
      }, { onConflict: 'examination_id,student_id,subject_id' });
      if (error) errorCount++;
    }

    saveMsg.textContent = errorCount > 0
      ? `Saved with ${errorCount} error(s) — check marks don't exceed max marks.`
      : (newStatus === 'DRAFT' ? 'Marks saved as draft.' : 'Marks submitted for approval.');

    if (errorCount > 0) {
      showToast('Some marks could not be saved — check values.', true);
    } else {
      showToast(newStatus === 'DRAFT' ? 'Marks saved!' : 'Submitted for approval!');
    }

    if (newStatus === 'PENDING_APPROVAL' && errorCount === 0) {
      const subjectName = document.getElementById('marks-subject-select').selectedOptions[0]?.textContent;
      const examName = document.getElementById('marks-exam-select').selectedOptions[0]?.textContent;
      await notify(await getOwnerId(), `Marks submitted for approval: ${subjectName} — ${examName}`);
    }
    await loadMarksEntryTable();
  }

  document.getElementById('btn-save-marks').addEventListener('click', () => saveMarks('DRAFT'));
  document.getElementById('btn-submit-marks').addEventListener('click', () => saveMarks('PENDING_APPROVAL'));

  // ================= NOTIFICATIONS =================
  let ownerProfileId = null; // cached so teachers can notify the owner

  async function getOwnerId() {
    if (ownerProfileId) return ownerProfileId;
    const { data } = await supabase.from('profiles').select('id').eq('role', 'owner').limit(1).maybeSingle();
    ownerProfileId = data?.id || null;
    return ownerProfileId;
  }

  async function notify(recipientId, message) {
    if (!recipientId) return;
    await supabase.from('notifications').insert({ recipient_id: recipientId, message });
  }

  async function loadNotifications(role) {
    const { data: { user } } = await supabase.auth.getUser();
    if (!user) return;
    const { data: notifs } = await supabase.from('notifications').select('id, message, is_read, created_at').eq('recipient_id', user.id).order('created_at', { ascending: false }).limit(20);

    const countEl = document.getElementById(role === 'owner' ? 'owner-bell-count' : 'teacher-bell-count');
    const dropdown = document.getElementById(role === 'owner' ? 'owner-notif-dropdown' : 'teacher-notif-dropdown');
    const unread = (notifs || []).filter(n => !n.is_read).length;

    if (unread > 0) { countEl.textContent = unread; countEl.classList.remove('hidden'); }
    else { countEl.classList.add('hidden'); }

    dropdown.innerHTML = (notifs && notifs.length > 0)
      ? notifs.map(n => `<div class="p-3 border-b border-border-subtle text-body-sm font-body-sm ${n.is_read ? 'text-on-surface-variant' : 'font-semibold text-on-surface'}">${n.message}<div class="text-xs text-on-surface-variant mt-1">${new Date(n.created_at).toLocaleString('en-IN')}</div></div>`).join('')
      : '<div class="p-4 text-center text-body-sm font-body-sm text-on-surface-variant">No notifications yet.</div>';
  }

  function setupBell(role) {
    const btn = document.getElementById(role === 'owner' ? 'btn-owner-bell' : 'btn-teacher-bell');
    const dropdown = document.getElementById(role === 'owner' ? 'owner-notif-dropdown' : 'teacher-notif-dropdown');
    btn.addEventListener('click', async (e) => {
      e.stopPropagation();
      dropdown.classList.toggle('hidden');
      if (!dropdown.classList.contains('hidden')) {
        const { data: { user } } = await supabase.auth.getUser();
        await supabase.from('notifications').update({ is_read: true }).eq('recipient_id', user.id).eq('is_read', false);
        await loadNotifications(role);
      }
    });
    document.addEventListener('click', (e) => {
      if (!dropdown.contains(e.target) && e.target !== btn) dropdown.classList.add('hidden');
    });
  }
  setupBell('owner');
  setupBell('teacher');

