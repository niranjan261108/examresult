<script type="module">
  import { createClient } from 'https://esm.sh/@supabase/supabase-js@2';

  const SUPABASE_URL = 'https://qeqpfnijcbqdipoesgqa.supabase.co';
  const SUPABASE_KEY = 'sb_publishable_HK1-UOtqcuELAfZ1N8gSXA_6mG_Ngl5';
  const supabase = createClient(SUPABASE_URL, SUPABASE_KEY);

function showToast(message, isError) {
    const container = document.getElementById('toast-container');
    const toast = document.createElement('div');
    toast.className = `px-5 py-3 rounded-lg shadow-lg font-label-md text-label-md flex items-center gap-2 ${isError ? 'bg-error-fail text-white' : 'bg-success-pass text-white'}`;
    toast.innerHTML = `<span class="material-symbols-outlined text-[18px]">${isError ? 'error' : 'check_circle'}</span> ${message}`;
    container.appendChild(toast);
    setTimeout(() => { toast.style.opacity = '0'; toast.style.transition = 'opacity .3s'; setTimeout(() => toast.remove(), 300); }, 2200);
  }


  // ---- view router ----
  // This page (staff.html) is the ENTIRE protected staff experience --
  // it contains no student-facing markup at all. The login form is the
  // default and only entry view; the Teacher/Owner dashboard <section>s
  // are detached from the document further below and only re-attached
  // after a real successful Supabase login + role check.
  document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
  document.getElementById('view-staff-login').classList.add('active');

  function showView(id) {
    document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
    document.getElementById(id).classList.add('active');
  }
  // "Back to result search" now leaves this protected page entirely and
  // goes to the public student site, since there is no search view here.
  document.querySelectorAll('.btn-back-to-search').forEach(b => b.addEventListener('click', () => { window.location.href = 'index.html'; }));

  // Returns true while the owner's timed "hide staff login" window is
  // active. During this window NOBODY -- student, teacher, or owner --
  // can reach or use the staff panels. Access returns automatically once
  // the timer passes; there is no early-exit from inside the app.
  async function isEverythingLocked() {
    const { data: settings } = await supabase.from('system_settings').select('hide_staff_login_until').eq('id', 1).single();
    const until = settings?.hide_staff_login_until ? new Date(settings.hide_staff_login_until) : null;
    return !!(until && until.getTime() > Date.now());
  }

  async function refreshStaffLoginOptions() {
    const select = document.getElementById('staff-select');
    const notice = document.getElementById('staff-login-endexam-notice');

    const { data: settings } = await supabase.from('system_settings').select('end_exam_result_active').eq('id', 1).single();
    const active = settings?.end_exam_result_active || false;

    const { data: people, error } = await supabase
  .from('profiles')
  .select('full_name, email, role, active')
  .eq('active', true)
  .in('role', ['teacher', 'owner'])
  .not('email', 'is', null)
  .order('full_name');

    

if (error) {
  console.error('STAFF PROFILE LOAD ERROR:', error);
  select.innerHTML = '<option disabled selected>Error loading staff</option>';
  return;
}

console.log('STAFF PEOPLE:', people);

    select.innerHTML = '<option disabled selected value="">Select authorized personnel</option>' +
      (people || []).map(p => `<option value="${p.email}" data-role="${p.role}">${p.full_name}${p.role === 'owner' ? ' (Owner)' : ''}</option>`).join('');

    if (notice) notice.classList.toggle('hidden', !active);
  }

  // On load: if a valid staff session already exists in this browser,
  // route straight in. Otherwise show the login form -- locking it if
  // the owner's timed lock is currently active.
  (async () => {
    const { data: { session } } = await supabase.auth.getSession();
    if (session) {
      await routeAfterLogin();
      return;
    }
    if (await isEverythingLocked()) {
      showStaffError('Staff access is temporarily unavailable. Please try again later.');
      document.getElementById('staff-login-form').querySelectorAll('input, button, select').forEach(el => el.disabled = true);
      return;
    }
    await refreshStaffLoginOptions();
  })();

  // ---- staff login ----
  const staffForm = document.getElementById('staff-login-form');
  const staffError = document.getElementById('staff-login-error');
  const staffSubmitBtn = document.getElementById('staff-login-submit');
  const staffSubmitText = document.getElementById('staff-login-submit-text');

  document.getElementById('toggle-staff-password').addEventListener('click', () => {
    const input = document.getElementById('staff-password');
    const icon = document.getElementById('staff-visibility-icon');
    if (input.type === 'password') { input.type = 'text'; icon.textContent = 'visibility_off'; }
    else { input.type = 'password'; icon.textContent = 'visibility'; }
  });

  function setStaffLoading(loading) {
    staffSubmitBtn.disabled = loading;
    staffSubmitText.textContent = loading ? 'Signing in...' : 'AUTHORIZE LOGIN';
  }
  function showStaffError(msg) {
    staffError.textContent = msg;
    staffError.classList.remove('hidden');
  }
  function hideStaffError() {
    staffError.classList.add('hidden');
  }

  staffForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    hideStaffError();
    const email = document.getElementById('staff-select').value;
    const password = document.getElementById('staff-password').value;
    if (!email || !password) return;

    setStaffLoading(true);
    const { data, error } = await supabase.auth.signInWithPassword({ email, password });
    setStaffLoading(false);

    if (error) {
      showStaffError('Incorrect password, or this account is not set up correctly. Please try again.');
      return;
    }

    await routeAfterLogin();
  });

async function routeAfterLogin() {
    const { data: { user } } = await supabase.auth.getUser();
    if (!user) { showView('view-staff-login'); return; }

    const { data: profile, error: profileError } = await supabase
      .from('profiles')
      .select('full_name, role, active')
      .eq('id', user.id)
      .single();

    if (profileError || !profile || !profile.active) {
      await supabase.auth.signOut();
      showStaffError('This account is not authorized to access the portal. Please contact the owner.');
      showView('view-staff-login');
      return;
    }

    // Hard lock: while the owner's "hide staff login" timer is running,
    // NOBODY gets into any panel — owner included. This is checked before
    // the owner/teacher branch so there is no exception for either role.
    if (await isEverythingLocked()) {
      await supabase.auth.signOut();
      showStaffError('Staff access is temporarily unavailable. Please try again later.');
      showView('view-staff-login');
      return;
    }

    if (profile.role === 'owner') {
      mountStaffPortal('owner');
      await loadOwnerPortal();
      showView('view-owner-dashboard');
      startLockWatchdog();
    } else {
      const { data: settings } = await supabase.from('system_settings').select('end_exam_result_active').eq('id', 1).single();
      if (settings?.end_exam_result_active) {
        await supabase.auth.signOut();
        showStaffError('Staff access is temporarily disabled by the owner. Please contact Mr. Vishnu Aravind.');
        showView('view-staff-login');
        return;
      }
      mountStaffPortal('teacher');
      await loadTeacherPortal(user.id, profile.full_name);
      showView('view-teacher-dashboard');
      startLockWatchdog();
    }
  }

  document.getElementById('btn-teacher-logout').addEventListener('click', async () => {
    await supabase.auth.signOut();
    resetTeacherState();
    unmountStaffPortal();
    showView('view-search');
  });
  // Lets a teacher hand off to the owner without going all the way back to
  // the result page first: signs the teacher out, then reopens the same
  // staff login form so the owner can sign in from there.
  document.getElementById('btn-teacher-owner-login').addEventListener('click', async () => {
    await supabase.auth.signOut();
    resetTeacherState();
    unmountStaffPortal();
    await refreshStaffLoginOptions();
    showView('view-staff-login');
  });
  document.getElementById('btn-owner-logout').addEventListener('click', async () => {
    await supabase.auth.signOut();
    unmountStaffPortal();
    showView('view-search');
  });

  // ---- Teacher Portal state ----
  let teacherAssignments = []; // [{class_id, subject_id, class_name, subject_name}]
  let currentTeacherId = null;

  function resetTeacherState() {
    teacherAssignments = [];
    currentTeacherId = null;
  }

  async function loadTeacherPortal(userId, fullName) {
    currentTeacherId = userId;
    document.getElementById('teacher-name-display').textContent = fullName;

    const { data: assignments } = await supabase
      .from('teacher_assignments')
      .select('class_id, subject_id, classes(display_name), subjects(name)')
