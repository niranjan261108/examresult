function escapeHtml(str){
  const d = document.createElement("div");
  d.textContent = str == null ? "" : str;
  return d.innerHTML;
}

async function exportPdf(students, attendance){
  try{ await loadJsPdf(); }catch(e){ alert("Could not load the PDF library. Check your connection and try again."); return; }
  const { jsPDF } = window.jspdf;
  const doc = new jsPDF();
  const boardName = boardDisplayName(state.board);

  doc.setFont("helvetica", "bold");
  doc.setFontSize(16);
  try{ doc.addImage(LOGO_PNG_DATA_URI, "PNG", 168, 10, 28, 28); }catch(e){ console.error("logo embed failed", e); }
  doc.text("Vishnu Tuition Centre — Attendance Register", 14, 18);
  doc.setFontSize(11);
  doc.setFont("helvetica", "normal");
