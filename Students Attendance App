// Read-only view: how many days each student in this class has been marked
// Present / Absent, tallied across every date ever recorded. Does not read
// or write anything used by the daily register — students, per-date
// attendance, and everything else keep working exactly as before.
async function AttendanceSummaryView(){
  const container = document.createElement("div");
