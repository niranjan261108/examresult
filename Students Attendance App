  doc.text("Roll No", 14, y);
  doc.text("Name", 40, y);
  doc.text("Batch", 100, y);
  doc.text("School", 130, y);
  doc.text("Status", 178, y);
  y += 4;
  doc.line(14, y, 196, y);
  y += 6;

  doc.setFont("helvetica", "normal");
  const sorted = [...students].sort((a,b) => (a.roll||"").localeCompare(b.roll||"", undefined, {numeric:true}));
  let presentCount = 0, absentCount = 0, noClassCount = 0;

  sorted.forEach(s => {
    if(y > 280){ doc.addPage(); y = 20; }
    const effStatus = effectiveStatus(attendance[s.id]);
    const status = effStatus === "present" ? "Present" : effStatus === "absent" ? "Absent" : "No Class";
    if(effStatus === "present") presentCount++;
    else if(effStatus === "absent") absentCount++;
    else noClassCount++;
    doc.text(String(s.roll), 14, y);
    doc.text(String(s.name).slice(0,28), 40, y);
    doc.text(String(s.batch).slice(0,14), 100, y);
    doc.text(String(s.school).slice(0,20), 130, y);
    if(status === "Present") doc.setTextColor(47,123,79);
    else if(status === "Absent") doc.setTextColor(175,53,39);
    else doc.setTextColor(90,75,46);
    doc.text(status, 178, y);
    doc.setTextColor(0,0,0);
    y += 7;
