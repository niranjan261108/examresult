      <div class="empty-state">
        <div class="big">No students in this class yet</div>
        <div>Add students from the register first, then their attendance counts will show up here.</div>
      </div>
    `));
    return container;
  }

  // Scoped to the selected month only — a previous month's records never
  // add into this month's totals, and vice versa.
  const history = await loadAttendanceForClassMonth(state.board, state.cls, state.summaryMonth);
  const totalsById = {};
  students.forEach(s => { totalsById[s.id] = { present: 0, absent: 0, noclass: 0, total: 0 }; });
  history.forEach(({ map }) => {
    students.forEach(s => {
      // Every recorded date counts for every student in the class, and a
      // student's status on that date is always one of present / absent /
      // no-class — nothing is left uncounted, which is what previously let
      // "No Class" days silently vanish from the totals instead of showing
      // up as their own row.
      const status = effectiveStatus(map[s.id]);
      totalsById[s.id][status]++;
      totalsById[s.id].total++;
    });
  });

  const sorted = [...students].sort((a,b) => (a.roll||"").localeCompare(b.roll||"", undefined, {numeric:true}));

  const table = el(`
    <table class="register-table">
      <thead>
