async function OwnerDashboardView(){
  if(!ownerAuthed){
    state.view = "ownerLogin";
    return el(`<div></div>`);
  }
  const wrap = document.createElement("div");

  const toolbar = el(`
    <div class="toolbar">
      <div class="toolbar-left">
        <div class="date-field">
          <label>Date</label>
          <input type="date" value="${state.ownerDate}" />
        </div>
      </div>
      <div style="display:flex;gap:10px;">
        <button class="btn btn-refresh" style="background:var(--paper-deep);">⟳ Refresh</button>
        <button class="btn btn-pdf">Download PDF</button>
        <button class="btn btn-cancel" style="background:var(--paper-deep);">Change Password</button>
        <button class="btn btn-logout" style="background:var(--paper-deep);">Log Out</button>
      </div>
    </div>
  `);
  toolbar.querySelector("input[type=date]").onchange = (e) => { state.ownerDate = e.target.value; render(); };
  toolbar.querySelector(".btn-refresh").onclick = () => { render(); };
  toolbar.querySelector(".btn-cancel").onclick = () => { openChangePassword(); };
  toolbar.querySelector(".btn-logout").onclick = () => {
    ownerAuthed = false;
    localStorage.removeItem("ownerAuthed");
    state.view = "home";
    render();
  };
  wrap.appendChild(toolbar);

  // gather all data across boards/classes — fetch every class in parallel instead of
  // one-at-a-time, and only once (previously this ran twice, sequentially, for ~88
  // round trips total; now it's one batch of parallel requests).
  // forceRefresh=true here because this view shows what OTHER devices (staff) have
  // marked — it must never serve stale in-memory cache from an earlier visit.
  const classKeys = [];
  for(const [boardId, b] of Object.entries(BOARDS)){
    for(const c of b.classes) classKeys.push({ boardId, boardName: b.name, cls: c });
  }
  // Morning Class Attendance is a separate board (keyed "morning") and was
  // previously left out of the owner summary entirely — include it here too.
  for(const c of MORNING_CLASSES){
    classKeys.push({ boardId: "morning", boardName: boardDisplayName("morning"), cls: c });
  }
  const classData = await Promise.all(classKeys.map(async ({boardId, boardName, cls}) => {
    const [students, attendance] = await Promise.all([
      loadStudents(boardId, cls, true),
      loadAttendance(boardId, cls, state.ownerDate, true)
    ]);
    return { boardId, boardName, cls, students, attendance };
  }));

  const rows = [];
  let totalStudents = 0, totalPresent = 0, totalAbsent = 0, totalNoClass = 0;
  const classSummaries = [];
  classData.forEach(({ boardName, cls, students, attendance }) => {
    let present = 0, absent = 0, noClass = 0;
    students.forEach(s => {
      const status = effectiveStatus(attendance[s.id]);
      if(status === "present") present++;
      else if(status === "absent") absent++;
      else noClass++;
      rows.push({ board: boardName, cls, ...s, status });
    });
    totalStudents += students.length;
    totalPresent += present;
    totalAbsent += absent;
    totalNoClass += noClass;
    if(students.length > 0){
      classSummaries.push({ boardName, cls, total: students.length, present, absent, noClass });
    }
  });

  toolbar.querySelector(".btn-pdf").onclick = () => exportOwnerPdf(rows, state.ownerDate, totalStudents, totalPresent, totalAbsent, totalNoClass);

  const stats = el(`
    <div class="stat-cards">
      <div class="stat-card"><div class="n">${totalStudents}</div><div class="l">Total Students</div></div>
      <div class="stat-card present"><div class="n">${totalPresent}</div><div class="l">Present Today</div></div>
      <div class="stat-card absent"><div class="n">${totalAbsent}</div><div class="l">Absent Today</div></div>
      <div class="stat-card noclass"><div class="n">${totalNoClass}</div><div class="l">No Class Today</div></div>
    </div>
  `);
  wrap.appendChild(stats);

  // per class breakdown
  wrap.appendChild(el(`<div class="owner-section-title">Class-wise Summary &middot; ${state.ownerDate}</div>`));
  const classTable = el(`
    <table class="register-table">
      <thead><tr><th>Board</th><th>Class</th><th>Total</th><th>Present</th><th>Absent</th><th>No Class</th></tr></thead>
      <tbody></tbody>
    </table>
  `);
  const ctbody = classTable.querySelector("tbody");
  classSummaries.forEach(({ boardName, cls, total, present, absent, noClass }) => {
    ctbody.appendChild(el(`
      <tr><td>${boardName}</td><td class="roll">Class ${cls}</td><td>${total}</td>
      <td style="color:var(--present-dark);font-weight:600;">${present}</td>
      <td style="color:var(--absent-dark);font-weight:600;">${absent}</td>
      <td style="color:var(--noclass-dark);font-weight:600;">${noClass}</td></tr>
    `));
  });
  wrap.appendChild(classTable);

  // full directory
  wrap.appendChild(el(`<div class="owner-section-title">All Students</div>`));
  const search = el(`<input class="search-field" type="text" placeholder="Search by name, roll, batch or school..." />`);
  wrap.appendChild(search);

  const dirTable = el(`
    <table class="register-table">
      <thead><tr><th>Board</th><th>Class</th><th>Roll</th><th>Name</th><th>Batch</th><th>School</th><th>Status</th></tr></thead>
      <tbody></tbody>
    </table>
  `);
  const dtbody = dirTable.querySelector("tbody");

  function renderDirectory(filter){
    dtbody.innerHTML = "";
    const f = filter.trim().toLowerCase();
    const filtered = rows.filter(r => !f ||
      r.name.toLowerCase().includes(f) || r.roll.toLowerCase().includes(f) ||
      r.batch.toLowerCase().includes(f) || r.school.toLowerCase().includes(f));
    if(filtered.length === 0){
      dtbody.appendChild(el(`<tr><td colspan="7" style="text-align:center;color:var(--ink-soft);">No students found</td></tr>`));
      return;
    }
    filtered.forEach(r => {
      const statusLabel = r.status === "present" ? "Present" : r.status === "absent" ? "Absent" : "No Class";
      const statusColor = r.status === "present" ? "var(--present-dark)" : r.status === "absent" ? "var(--absent-dark)" : "var(--noclass-dark)";
      dtbody.appendChild(el(`
        <tr>
          <td>${escapeHtml(r.board)}</td><td class="roll">Class ${r.cls}</td><td class="roll">${escapeHtml(r.roll)}</td>
          <td class="name">${escapeHtml(r.name)}</td><td>${escapeHtml(r.batch)}</td><td class="school">${escapeHtml(r.school)}</td>
          <td style="color:${statusColor};font-weight:600;">${statusLabel}</td>
        </tr>
      `));
    });
  }
  search.oninput = (e) => renderDirectory(e.target.value);
  renderDirectory("");
  wrap.appendChild(dirTable);

  return wrap;
}

