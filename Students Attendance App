        </div>
      </div>
    </div>
  `);
  const picker = overlay.querySelector("#day-picker");
  MORNING_DAY_OPTIONS.forEach(day => {
    const chip = el(`
      <label class="day-chip">
        <input type="checkbox" value="${day}" ${currentDays.includes(day) ? "checked" : ""} />
        ${day}
      </label>
    `);
    picker.appendChild(chip);
  });

  // Same students already exist under State Board / CBSE for this class number —
  // let the owner pull that roster into the morning register instead of retyping it.
  const copyButtonsWrap = overlay.querySelector("#copy-buttons");
  const copyStatus = overlay.querySelector("#copy-status");
  let anySource = false;
  for(const [boardId, b] of Object.entries(BOARDS)){
    if(!b.classes.includes(cls)) continue;
    const source = await loadStudents(boardId, cls);
    if(source.length === 0) continue;
    anySource = true;
    const btn = el(`<button type="button" class="btn-copy-source">Copy ${source.length} from ${b.name}</button>`);
    btn.onclick = async () => {
      btn.disabled = true;
      btn.textContent = "Copying\u2026";
      const added = await copyStudentsIntoMorning(cls, boardId);
      copyStatus.textContent = added > 0
        ? `Copied ${added} student${added===1?"":"s"} from ${b.name}.`
        : `Everyone from ${b.name} is already in this class's morning register.`;
      btn.disabled = false;
      btn.textContent = `Copy ${source.length} from ${b.name}`;
    };
    copyButtonsWrap.appendChild(btn);
  }
  if(!anySource){
    copyStatus.textContent = "No students found in State Board or CBSE for this class yet.";
  }

  overlay.addEventListener("click", (e) => { if(e.target === overlay){ state.morningConfigCls=null; render(); } });
  overlay.querySelector(".btn-cancel").onclick = () => { state.morningConfigCls=null; render(); };
  overlay.querySelector(".btn-save").onclick = async () => {
    const selected = Array.from(picker.querySelectorAll("input[type=checkbox]:checked")).map(cb => cb.value);
    const currentCfg = await loadMorningConfig();
    if(selected.length){
      currentCfg[cls] = { days: selected };
    } else {
      delete currentCfg[cls];
    }
    await saveMorningConfig(currentCfg);
    state.morningConfigCls = null;
    render();
  };
  return overlay;
}

