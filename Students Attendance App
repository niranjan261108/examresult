async function exportOwnerPdf(rows, date, totalStudents, totalPresent, totalAbsent, totalNoClass){
  try{ await loadJsPdf(); }catch(e){ alert("Could not load the PDF library. Check your connection and try again."); return; }
  const { jsPDF } = window.jspdf;
  const doc = new jsPDF();

  doc.setFont("helvetica", "bold");
  doc.setFontSize(16);
  try{ doc.addImage(LOGO_PNG_DATA_URI, "PNG", 168, 10, 28, 28); }catch(e){ console.error("logo embed failed", e); }
  doc.text("Vishnu Tuition Centre — Owner Report", 14, 18);
  doc.setFontSize(11);
  doc.setFont("helvetica", "normal");
  doc.text(`Date: ${date}`, 14, 26);
  doc.setDrawColor(180, 160, 120);
  doc.line(14, 30, 196, 30);
  doc.setFont("helvetica", "bold");
  doc.text(`Total: ${totalStudents}    Present: ${totalPresent}    Absent: ${totalAbsent}    No Class: ${totalNoClass}`, 14, 38);

  let y = 50;
  let firstPage = true;
  const drawHeader = () => {
    if(!firstPage){
      try{ doc.addImage(LOGO_PNG_DATA_URI, "PNG", 178, 4, 16, 16); }catch(e){ /* ignore */ }
    }
    firstPage = false;
    doc.setFont("helvetica", "bold");
    doc.setFontSize(9);
    doc.text("Board", 14, y);
    doc.text("Class", 42, y);
    doc.text("Roll", 58, y);
    doc.text("Name", 76, y);
    doc.text("Batch", 118, y);
    doc.text("School", 145, y);
    doc.text("Status", 180, y);
    y += 4;
    doc.line(14, y, 196, y);
    y += 6;
    doc.setFont("helvetica", "normal");
  };
  drawHeader();

  const sorted = [...rows].sort((a,b) => {
    if(a.board !== b.board) return a.board.localeCompare(b.board);
    if(a.cls !== b.cls) return a.cls - b.cls;
    return (a.roll||"").localeCompare(b.roll||"", undefined, {numeric:true});
  });

  sorted.forEach(r => {
    if(y > 280){ doc.addPage(); y = 20; drawHeader(); }
    const status = r.status === "present" ? "Present" : r.status === "absent" ? "Absent" : "No Class";
    doc.setFontSize(8);
    doc.text(String(r.board).slice(0,14), 14, y);
    doc.text(String(r.cls), 42, y);
    doc.text(String(r.roll).slice(0,10), 58, y);
    doc.text(String(r.name).slice(0,22), 76, y);
    doc.text(String(r.batch).slice(0,14), 118, y);
    doc.text(String(r.school).slice(0,17), 145, y);
    if(status === "Present") doc.setTextColor(47,123,79);
    else if(status === "Absent") doc.setTextColor(175,53,39);
    else doc.setTextColor(90,75,46);
    doc.text(status, 180, y);
    doc.setTextColor(0,0,0);
    y += 6.5;
  });

  doc.save(`Owner_Attendance_Report_${date}.pdf`);
}

// Splash screen: shown instantly (pure HTML/CSS) so it appears before any
// script finishes loading; we just make sure it stays up for a minimum time
// and only fades out once the app has actually rendered underneath it.
const SPLASH_MIN_MS = 1500;
const splashStart = Date.now();
function hideSplash(){
  const splash = document.getElementById("splash-screen");
  if(!splash) return;
  const elapsed = Date.now() - splashStart;
  const remaining = Math.max(0, SPLASH_MIN_MS - elapsed);
  setTimeout(() => {
    splash.classList.add("splash-hide");
    splash.addEventListener("transitionend", () => splash.remove(), { once: true });
  }, remaining);
}

authReady.then(async () => { await render(); hideSplash(); });
