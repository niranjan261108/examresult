      </thead>
      <tbody></tbody>
    </table>
  `);
  const tbody = table.querySelector("tbody");
  sorted.forEach(s => {
    const t = totalsById[s.id];
    tbody.appendChild(el(`
      <tr>
        <td class="roll">${escapeHtml(s.roll)}</td>
        <td class="name">${escapeHtml(s.name)}</td>
        <td>${escapeHtml(s.batch)}</td>
        <td class="school">${escapeHtml(s.school)}</td>
        <td style="color:var(--present-dark);font-weight:600;">${t.present}</td>
        <td style="color:var(--absent-dark);font-weight:600;">${t.absent}</td>
        <td style="color:var(--noclass-dark);font-weight:600;">${t.noclass}</td>
        <td>${t.total}</td>
      </tr>
    `));
  });
  container.appendChild(table);

  if(history.length === 0){
    container.appendChild(el(`
      <div class="empty-state">
        <div class="big">No attendance recorded for ${escapeHtml(monthLabel(state.summaryMonth))}</div>
        <div>Pick a different month above, or mark attendance on the register first.</div>
      </div>
    `));
  }

  toolbar.querySelector(".btn-pdf").onclick = () => exportAttendanceSummaryPdf(sorted, totalsById, state.summaryMonth);

  return container;
}

