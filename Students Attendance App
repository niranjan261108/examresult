  container.appendChild(el(`
    <div class="owner-section-title" style="margin-top:2px;">
      Student Attendance Summary &middot; ${escapeHtml(boardDisplayName(state.board))} &middot; Class ${state.cls} &middot; ${escapeHtml(monthLabel(state.summaryMonth))}
    </div>
  `));

