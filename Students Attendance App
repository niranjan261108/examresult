  doc.line(14, y, 196, y);
  y += 8;
  doc.setFont("helvetica", "bold");
  doc.text(`Total: ${students.length}    Present: ${presentCount}    Absent: ${absentCount}    No Class: ${noClassCount}`, 14, y);

  doc.save(`Attendance_${boardName.replace(/\s+/g,"")}_Class${state.cls}_${state.date}.pdf`);
}

