}

// Copies students from an SB/CBSE class into the Morning Class roster for the
// same class number, skipping anyone already there (matched by name + roll).
async function copyStudentsIntoMorning(cls, fromBoard){
  const source = await loadStudents(fromBoard, cls);
  const target = await loadStudents("morning", cls);
  const existingKeys = new Set(target.map(s => (s.name+"|"+s.roll).toLowerCase().trim()));
  let added = 0;
  source.forEach(s => {
    const key = (s.name+"|"+s.roll).toLowerCase().trim();
    if(existingKeys.has(key)) return;
    target.push({ id: "s_"+Date.now()+"_"+Math.random().toString(36).slice(2,7), name: s.name, batch: s.batch, roll: s.roll, school: s.school });
    existingKeys.add(key);
    added++;
  });
  await saveStudents("morning", cls, target);
  return added;
}

function todayStr(){
  const d = new Date();
  return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0");
}
function studentsKey(board, cls){ return `students:${board}:${cls}`; }
function attendanceKey(board, cls, date){ return `attendance:${board}:${cls}:${date}`; }

// A student is only "present" or "absent" if explicitly marked that way.
// Anything else — including old records from before "No Class" existed,
// where nothing was ever marked — is treated as "No Class" automatically.
function effectiveStatus(status){
  return (status === "present" || status === "absent") ? status : "noclass";
}

async function loadStudents(board, cls, forceRefresh){
  const key = studentsKey(board, cls);
  if(!forceRefresh && cache.students[key]) return cache.students[key];
  const raw = await dbGet(key);
  const list = raw ? JSON.parse(raw) : [];
  cache.students[key] = list;
  return list;
}
async function saveStudents(board, cls, list){
  const key = studentsKey(board, cls);
  cache.students[key] = list;
  await dbSet(key, JSON.stringify(list));
}
async function loadAttendance(board, cls, date, forceRefresh){
  const key = attendanceKey(board, cls, date);
  if(!forceRefresh && cache.attendance[key]) return cache.attendance[key];
  const raw = await dbGet(key);
  const map = raw ? JSON.parse(raw) : {};
  cache.attendance[key] = map;
  return map;
}
async function saveAttendance(board, cls, date, map){
  const key = attendanceKey(board, cls, date);
  cache.attendance[key] = map;
  await dbSet(key, JSON.stringify(map));
}

// Loads every attendance record ever saved for a class (across all dates),
// using a Firestore document-ID range query on the "attendance:board:cls:"
// prefix. Used only by the Student Attendance Summary view — the existing
// per-date loadAttendance()/saveAttendance() flow above is untouched.
async function loadAllAttendanceForClass(board, cls){
  const prefix = attendanceKey(board, cls, "");
  try{
    const snap = await db.collection("kv_store")
      .where(firebase.firestore.FieldPath.documentId(), ">=", prefix)
      .where(firebase.firestore.FieldPath.documentId(), "<", prefix + "\uf8ff")
      .get();
    return snap.docs.map(doc => {
      const date = doc.id.slice(prefix.length);
      let map = {};
      try{ map = doc.data().value ? JSON.parse(doc.data().value) : {}; }catch(e){ /* skip malformed record */ }
      return { date, map };
    });
  }catch(e){
    console.error("Failed to load attendance history:", board, cls, e);
    return [];
  }
}

// Same as loadAllAttendanceForClass but scoped to a single calendar month
// ("YYYY-MM"), so one month's data never bleeds into another month's totals.
async function loadAttendanceForClassMonth(board, cls, monthStr){
  const all = await loadAllAttendanceForClass(board, cls);
  return all.filter(({ date }) => date.startsWith(monthStr));
}
function monthLabel(monthStr){
  const [y, m] = monthStr.split("-").map(Number);
  const d = new Date(y, m - 1, 1);
  return d.toLocaleDateString("en-IN", { month: "long", year: "numeric" });
}

