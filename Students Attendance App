  overlay.querySelector(".btn-cancel").onclick = () => { state.modalOpen=false; state.editingId=null; render(); };
  overlay.querySelector(".btn-save").onclick = async () => {
    const name = overlay.querySelector("#f-name").value.trim();
    const batch = overlay.querySelector("#f-batch").value.trim();
    const roll = overlay.querySelector("#f-roll").value.trim();
    const school = overlay.querySelector("#f-school").value.trim();
    if(!name || !batch || !roll || !school){
      overlay.querySelector("#f-err").style.display = "block";
      return;
    }
    const currentList = await loadStudents(state.board, state.cls);
    if(isEdit){
      const idx = currentList.findIndex(s => s.id === state.editingId);
      if(idx > -1) currentList[idx] = { ...currentList[idx], name, batch, roll, school };
    } else {
      currentList.push({ id: "s_"+Date.now()+"_"+Math.random().toString(36).slice(2,7), name, batch, roll, school });
    }
    await saveStudents(state.board, state.cls, currentList);
    state.modalOpen = false;
    state.editingId = null;
    render();
  };
  return overlay;
}

