// If a teacher never marks anything at all for a working day — no "Tut Came
// Sir", no "Tut Over Sir", no Leave, no Permission — that day is
// automatically counted as Leave once the day has passed, even though the
// Leave option was sitting right there for both the teacher and the owner
// to use. Only touches days strictly before today, and only days that had
// a class scheduled (skips off-days like Sunday). Mutates monthRec in
// place and saves it back if anything changed.
async function autoMarkPastUnmarkedLeaves(teacherId, teacher, monthKey, monthRec){
  const now = new Date();
  const todayKey = fmtDate(now);
  const [y,m] = monthKey.split('-').map(Number);
  const days = fmtMonthKey(now) === monthKey ? now.getDate() : daysInMonth(monthKey);
  let changed = false;
  for(let d=1; d<=days; d++){
    const dateObj = new Date(y, m-1, d);
    const dateStr = fmtDate(dateObj);
    if(dateStr >= todayKey) continue; // never touch today or the future
    const sched = getScheduledMinutes(teacher, dateObj);
    if(sched === null) continue; // no class that day
    const rec = monthRec[dateStr];
    const isUnmarked = !rec || (!rec.dayType && !rec.arrival);
    if(isUnmarked){
      monthRec[dateStr] = { ...(rec||{}), dayType:'leave', autoMarkedLeave:true, autoMarkedAt: now.toISOString() };
      changed = true;
    }
  }
  if(changed) await saveMonthRecord(teacherId, monthKey, monthRec);
  return changed;
}

// Wipes every document in the shared Firestore collection (all teachers'
// attendance, the teacher list, owner PIN, and the tuition center) plus the
// local cache. This is irreversible — only reachable from the Owner Desk,
// behind a typed confirmation.
async function eraseAllData(){
  const snap = await getDocs(collection(db, FIRESTORE_COLLECTION));
  const deletions = [];
  snap.forEach(d => deletions.push(deleteDoc(d.ref)));
  await Promise.all(deletions);
  try{
    const toRemove = [];
    for(let i=0; i<localStorage.length; i++){
      const k = localStorage.key(i);
      if(k && k.startsWith('reg-')) toRemove.push(k);
    }
    toRemove.forEach(k => localStorage.removeItem(k));
  }catch(e){}
}

function getScheduledMinutes(teacher, dateObj){
  const day = dateObj.getDay(); // 0 Sun ... 6 Sat
  const sundayTime = state.sundayClasses[fmtDate(dateObj)];
  if(day === 0){
    if(!sundayTime) return null; // closed Sunday, unless the owner has opened this one
    const [h,m] = sundayTime.split(':').map(Number);
    return h*60 + m;
  }
  const timeStr = (day === 6) ? teacher.schedule.saturday : teacher.schedule.weekday;
  const [h,m] = timeStr.split(':').map(Number);
  return h*60 + m;
}
function scheduleLabel(teacher){
  const wd = teacher.schedule.weekday, sa = teacher.schedule.saturday;
  if(wd === sa) return `Mon–Sat · ${fmtTimeStr(wd)}`;
  return `Mon–Fri ${fmtTimeStr(wd)} · Sat ${fmtTimeStr(sa)}`;
}

