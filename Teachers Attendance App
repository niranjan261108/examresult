    updateBox.querySelector('#recBtn').onclick = async ()=>{
      const statusEl = updateBox.querySelector('#recStatus');
      const recBtn = updateBox.querySelector('#recBtn');
      if(!navigator.mediaDevices || !window.MediaRecorder){
        statusEl.textContent = 'Voice recording not supported on this device.';
        return;
      }
      if(state.recording && state.recording.active){
        state.recording.recorder.stop();
        return;
      }
      try{
        const stream = await navigator.mediaDevices.getUserMedia({ audio:true });
        // Different phones support different recording formats (iPhones often
        // can't record webm at all — they use mp4/aac instead). Pick whichever
        // format this device actually supports, so playback matches later.
        const mimeCandidates = ['audio/mp4', 'audio/webm;codecs=opus', 'audio/webm', 'audio/ogg;codecs=opus', 'audio/aac'];
        let chosenMime = '';
        for(const c of mimeCandidates){
          if(window.MediaRecorder.isTypeSupported && MediaRecorder.isTypeSupported(c)){ chosenMime = c; break; }
        }
        const recorder = chosenMime ? new MediaRecorder(stream, { mimeType: chosenMime }) : new MediaRecorder(stream);
        const chunks = [];
        recorder.ondataavailable = e => chunks.push(e.data);
        recorder.onstop = async ()=>{
          stream.getTracks().forEach(t=>t.stop());
          // Tag the saved file with whatever format was actually recorded,
          // not a hardcoded one — otherwise playback fails on phones that
          // recorded in a different format than the tag claims.
          const actualMime = recorder.mimeType || chosenMime || 'audio/webm';
          const blob = new Blob(chunks, { type: actualMime });
          if(blob.size > 4_500_000){
            statusEl.textContent = 'Recording too long — keep it under ~2 minutes.';
            state.recording = null;
            recBtn.innerHTML = '🎙 Record Voice Note';
            return;
          }
          const reader = new FileReader();
          reader.onload = async ()=>{
            const base64 = reader.result;
            const rec = await loadMonthRecord(teacher.id, monthKey);
            rec[todayKey] = { ...(rec[todayKey]||{}), voiceNote: base64 };
            await saveMonthRecord(teacher.id, monthKey, rec);
            toast('Voice note saved');
            renderTeacherHome(content);
          };
          reader.readAsDataURL(blob);
        };
        recorder.start();
        state.recording = { recorder, active:true };
        recBtn.innerHTML = '<span class="rec-dot"></span> Stop Recording';
        statusEl.textContent = 'Recording…';
      }catch(e){
        statusEl.textContent = 'Microphone permission denied or unavailable.';
      }
    };
  }

  // This month's summary for the teacher themself — attendance stats only,
  // nothing from the owner-only notes column is shown here.
  const stats = computeMonthStats(monthRec, teacher, monthKey);
  const summary = document.createElement('div');
  summary.innerHTML = `
