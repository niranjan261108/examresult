      </div>
    </div>
    ${isCurrentMonth
      ? `<div class="muted" style="margin-top:8px; font-size:11.5px;">Today: ${todayFullLabel}. This month is still open — once it ends, come back here and use "Previous month" to calculate and lock salary.</div>`
      : locked
        ? `<div class="muted" style="margin-top:8px; font-size:11.5px;">This month is locked — owner-note deductions and day corrections are disabled here so the settled payroll figures can't change by accident.</div>`
        : `<div class="muted" style="margin-top:8px; font-size:11.5px;">Viewing a past month. Once you've calculated and paid salary from this register, lock it so it stays exactly as-is.</div>`
    }
  `;
  content.appendChild(monthNav);
  monthNav.querySelector('#prevMonthBtn').onclick = ()=>{ state.ownerViewMonth = shiftMonthKey(monthKey, -1); renderOwnerHome(content); };
  const nextBtn = monthNav.querySelector('#nextMonthBtn');
  if(nextBtn) nextBtn.onclick = ()=>{ state.ownerViewMonth = shiftMonthKey(monthKey, 1); renderOwnerHome(content); };
  const lockBtn = monthNav.querySelector('#lockMonthBtn');
  if(lockBtn) lockBtn.onclick = async ()=>{
    lockBtn.disabled = true; lockBtn.textContent = 'Locking…';
    await setMonthLocked(monthKey, true);
    toast(`${monthLabel(monthKey)} locked — salary settled`);
    renderOwnerHome(content);
  };
  const unlockBtn = monthNav.querySelector('#unlockMonthBtn');
  if(unlockBtn) unlockBtn.onclick = async ()=>{
    if(!confirm(`Unlock ${monthLabel(monthKey)}? This lets owner-note deductions and day corrections be edited again for this month.`)) return;
    await setMonthLocked(monthKey, false);
    toast(`${monthLabel(monthKey)} unlocked`);
    renderOwnerHome(content);
  };

  const tableScroll = document.createElement('div');
  tableScroll.className = 'table-scroll';
  const table = document.createElement('table');
  table.className = 'responsive-table';
  table.innerHTML = `
    <thead><tr>
      <th>Teacher</th>${isCurrentMonth ? '<th>Today</th><th>Reason</th>' : ''}<th>Late</th><th>Permission</th><th>Leave</th><th>Absent</th><th>Auto-deducted</th><th>Owner notes</th><th>Total to Deduct</th><th></th>
    </tr></thead>
    <tbody></tbody>
  `;
  const tbody = table.querySelector('tbody');
  rows.forEach(({teacher, stats, todayRec})=>{
    const tr = document.createElement('tr');
    let todayReasonCells = '';
    if(isCurrentMonth){
      let todayCell;
      if(todayRec && todayRec.dayType === 'leave'){
        todayCell = `<span class="stamp leave">Leave</span>`;
      } else if(todayRec && todayRec.dayType === 'permission' && !todayRec.arrival){
        todayCell = `<span class="stamp permission">Permission${todayRec.permissionMinutes ? ' · +'+todayRec.permissionMinutes+'m' : ''}</span>`;
      } else if(!todayRec || !todayRec.arrival){
        todayCell = `<span class="stamp pending">not yet</span>`;
      } else {
        const cls = todayRec.status === 'Late' ? 'late':'present';
        const loc = todayRec.location;
        const locTag = loc && loc.atTuition === false ? ' <span class="muted" style="font-size:10px;color:var(--ink-red);">(remote)</span>'
          : loc && loc.atTuition === true ? ' <span class="muted" style="font-size:10px;">(at tuition)</span>' : '';
        const permTag = todayRec.dayType === 'permission' ? ' <span class="stamp permission" style="font-size:10px; padding:2px 6px;">perm.</span>' : '';
        todayCell = `<span class="stamp ${cls}">${todayRec.status}</span>${permTag}<div class="muted" style="font-size:11px; margin-top:3px;">${fmtTime(new Date(todayRec.arrival))}${locTag}</div>`;
      }
      let reasonCell = '<span class="muted">—</span>';
      if(todayRec && todayRec.dayType === 'permission' && todayRec.permissionReason){
        reasonCell = `<div style="max-width:170px;">${escapeHtml(todayRec.permissionReason)}<div class="muted" style="font-size:10px; margin-top:2px;">+${todayRec.permissionMinutes || 0}m · informed: ${todayRec.permissionInformed ? 'yes' : 'no'}</div></div>`;
      }
      todayReasonCells = `<td data-label="Today">${todayCell}</td><td data-label="Reason">${reasonCell}</td>`;
    }
    const totalDeduction = (stats.autoDeductDays + stats.permissionHalfDays) * (teacher.dailySalary || 0) + stats.ownerDeductionRupees;
    const totalCell = ((stats.autoDeductDays > 0 || stats.permissionHalfDays > 0) && !teacher.dailySalary)
      ? `<span style="color:var(--ink-red); font-size:11.5px;">set salary</span>`
      : `<b>₹${totalDeduction}</b>`;
    const lateCell = `${stats.lateCount} / ${FREE_LATES}${stats.lateDeductDays ? ` <span style="color:var(--ink-red);">(-${stats.lateDeductDays}d)</span>` : ''}`;
    const permCell = `${stats.permissionCount} / ${FREE_PERMISSIONS}${stats.permissionHalfDays ? ` <span style="color:var(--ink-red);">(-${stats.permissionHalfDays}d)</span>` : ''}`;
    const leaveCell = `${stats.leaveCount} / ${FREE_LEAVES}${stats.leaveDeductDays ? ` <span style="color:var(--ink-red);">(-${stats.leaveDeductDays}d)</span>` : ''}`;
    tr.innerHTML = `
      <td data-label="Teacher"><b>${teacher.name}</b><div class="muted" style="font-size:11px;">${scheduleLabel(teacher)}</div></td>
      ${todayReasonCells}
      <td data-label="Late">${lateCell}</td>
      <td data-label="Permission">${permCell}</td>
      <td data-label="Leave">${leaveCell}</td>
      <td data-label="Absent">${stats.otherStrikes}</td>
      <td data-label="Auto-deducted">${stats.autoDeductDays} day(s)</td>
      <td data-label="Owner notes">₹${stats.ownerDeductionRupees}</td>
      <td data-label="Total to Deduct">${totalCell}</td>
      <td data-label="">
        <div>
          <button class="link-btn" data-id="${teacher.id}">open register →</button>
          <span style="margin:0 4px;color:var(--rule)">|</span>
          <button class="link-btn" data-delete-id="${teacher.id}" style="color:var(--ink-red);">delete</button>
        </div>
      </td>
    `;
    tbody.appendChild(tr);
  });
  tableScroll.appendChild(table);
  content.appendChild(tableScroll);
  table.querySelectorAll('button[data-id]').forEach(b=>{
    b.onclick = ()=>{ state.selectedTeacherForOwner = b.getAttribute('data-id'); state.screen='ownerTeacherDetail'; render(); };
  });
  table.querySelectorAll('button[data-delete-id]').forEach(b=>{
    b.onclick = async ()=>{
      const id = b.getAttribute('data-delete-id');
      const t = state.teachers.find(x=>x.id===id);
      if(!t) return;
      if(!confirm(`Remove ${t.name} from the active teacher list?\n\nTheir past attendance, class updates and deduction history will NOT be deleted — only their name will stop showing here.`)) return;
      state.teachers = state.teachers.filter(x=>x.id!==id);
      await saveTeachers();
      toast(`${t.name} removed from the list`);
      renderOwnerHome(content);
    };
  });
}

function renderAddTeacherForm(content, onDone){
  const wrap = document.createElement('div');
  wrap.className = 'today-card';
  wrap.innerHTML = `
    <div class="muted" style="margin-bottom:10px;">Add a teacher</div>
    <div class="field"><label>Name</label><input id="newName" placeholder="e.g. Kavya Mam"></div>
    <div class="field"><label>Mon–Fri time (24h, e.g. 17:00)</label><input id="newWd" placeholder="17:00"></div>
    <div class="field"><label>Saturday time (24h)</label><input id="newSa" placeholder="17:00"></div>
    <div class="error-msg" id="addErr"></div>
    <button class="btn" id="saveNew">Save Teacher</button>
    <button class="btn secondary" id="cancelNew" style="margin-left:8px;">Cancel</button>
  `;
  content.prepend(wrap);
  wrap.querySelector('#cancelNew').onclick = ()=>wrap.remove();
  wrap.querySelector('#saveNew').onclick = async ()=>{
    const name = wrap.querySelector('#newName').value.trim();
    const wd = wrap.querySelector('#newWd').value.trim();
    const sa = wrap.querySelector('#newSa').value.trim();
    const timeRe = /^([01]?\d|2[0-3]):[0-5]\d$/;
    if(!name || !timeRe.test(wd) || !timeRe.test(sa)){
      wrap.querySelector('#addErr').textContent = 'Fill all fields — times as HH:MM (24h).';
      return;
    }
    const id = name.toLowerCase().replace(/[^a-z]+/g,'-').replace(/(^-|-$)/g,'') + '-' + Date.now().toString(36).slice(-4);
    state.teachers.push({ id, name, pin:null, dailySalary:null, schedule:{ weekday:wd, saturday:sa } });
    await saveTeachers();
    wrap.remove();
    onDone();
  };
}

