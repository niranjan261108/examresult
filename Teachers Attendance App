// Rules:
// - Every teacher gets 1 free Permission + 1 free Leave + 3 free Lates each month.
// - Permission does NOT cancel the day — it just extends the teacher's expected
//   arrival time by however many minutes they asked for. They still have to mark
//   "Tut Came Sir" when they actually arrive; only Leave closes out the day.
// - Beyond the free late allowance, every further 3 lates = 1 day's salary deducted.
// - Missing the daily class update on a day the teacher attended counts as another
//   Late for that same day (it shares the same Late quota/deduction above — it is
//   NOT a separate free allowance).
// - The 1st Permission each month is free (no deduction). The Permission button
//   stays available every day even after the free one is used — but every
//   Permission used from the 2nd one onward that month costs HALF a day's salary
//   (not a full day, and not merged with the Late count), shown separately.
// - Beyond the 1 free Leave, each extra Leave used = 1 full day's salary deducted.
// - Full absence (no arrival at all, no permission/leave marked) keeps the old rule:
//   every 3 such absences = 1 day's salary deducted.
const FREE_LATES = 3;                // free lates every teacher gets each month
const FREE_PERMISSIONS = 1;
const FREE_LEAVES = 1;

function computeMonthStats(monthRec, teacher, monthKey){
  const now = new Date();
  const isCurrentMonth = fmtMonthKey(now) === monthKey;
  const totalDays = isCurrentMonth ? now.getDate() : daysInMonth(monthKey);
  let lateCount = 0, permissionCount = 0, leaveCount = 0, otherStrikes = 0, ownerNoteCount = 0, ownerDeductionRupees = 0;
  const [y,m] = monthKey.split('-').map(Number);
  for(let d=1; d<=totalDays; d++){
    const dateObj = new Date(y, m-1, d);
    if(isCurrentMonth && dateObj > now) break;
    const sched = getScheduledMinutes(teacher, dateObj);
    if(sched === null) continue; // Sunday
    const dateStr = fmtDate(dateObj);
    const rec = monthRec[dateStr];
    const isPastDay = dateObj < new Date(now.getFullYear(), now.getMonth(), now.getDate());
    if(rec && rec.dayType === 'permission'){
      permissionCount++;
      // Permission extends the arrival window but the teacher still has to show
      // up — if they never actually marked arrival on a past day, it's still a
      // full absence for that day. If they did arrive, treat it like a normal
      // attended day (Late / missing-update rules still apply on top of the
      // extended window).
      if(!rec.arrival){
        if(isPastDay) otherStrikes++;
      } else {
        if(rec.status === 'Late') lateCount++;
        const hasUpdate = (rec.classUpdate && rec.classUpdate.trim()) || rec.voiceNote;
        if(!hasUpdate && isPastDay && !rec.exemptNoUpdateLate) lateCount++;
      }
    } else if(rec && rec.dayType === 'leave'){
      leaveCount++;
    } else if(!rec || !rec.arrival){
      if(isPastDay) otherStrikes++; // absent entirely on a past working day
    } else {
      if(rec.status === 'Late') lateCount++;
      const hasUpdate = (rec.classUpdate && rec.classUpdate.trim()) || rec.voiceNote;
      if(!hasUpdate && isPastDay && !rec.exemptNoUpdateLate) lateCount++; // missing class update counts as another Late for that same day
    }
    if(rec && rec.ownerNotes && rec.ownerNotes.length){
      ownerNoteCount += rec.ownerNotes.length;
      ownerDeductionRupees += rec.ownerNotes.length * 200;
    }
  }

  const lateOver = Math.max(0, lateCount - FREE_LATES);
  const lateDeductDays = Math.floor(lateOver / 3);
  // 1st Permission each month is free. Every Permission used after that costs
  // half a day's salary — tracked separately from the full-day auto-deductions.
  const permissionExtra = Math.max(0, permissionCount - FREE_PERMISSIONS);
  const permissionHalfDays = permissionExtra * 0.5;
  const leaveDeductDays = Math.max(0, leaveCount - FREE_LEAVES);
  const otherDeductDays = Math.floor(otherStrikes / 3);
  const autoDeductDays = lateDeductDays + leaveDeductDays + otherDeductDays;
  return {
    lateCount, permissionCount, leaveCount, otherStrikes,
    lateDeductDays, permissionExtra, permissionHalfDays, leaveDeductDays, otherDeductDays,
    autoDeductDays,
    ownerNoteCount,
    ownerDeductionRupees
  };
}

