        <div class="meta">Permission details</div>
        <div>Extra time requested: ${rec.permissionMinutes || 0} min</div>
        ${rec.permissionReason ? `<div>Reason: ${escapeHtml(rec.permissionReason)}</div>` : ''}
        <div>Informed sir: ${rec.permissionInformed ? 'Yes' : 'No'}</div>
      </div>`;
    } else if(rec.arrival){
      const cls = rec.status === 'Late' ? 'late' : 'present';
      stampHtml = `<span class="stamp ${cls}">${rec.status}${rec.status==='Late' ? ' · '+rec.lateMinutes+'m' : ''}</span>`;
      timeHtml = `<span class="muted" style="margin-left:10px;">${fmtTime(new Date(rec.arrival))}${rec.departure ? ' → '+fmtTime(new Date(rec.departure)) : ''}</span>`;
    }
    const locationHtml = rec.arrival ? `<div style="margin-top:6px;">${locationBadgeHtml(rec.location)}</div>` : '';
    const hasUpdate = (rec.classUpdate && rec.classUpdate.trim()) || rec.voiceNote;
    const showNoUpdateWarning = rec.arrival && !hasUpdate;
    const correctedTag = rec.ownerCorrected ? ` <span class="muted" style="font-size:10px;">· corrected by owner</span>` : '';
    dayBlock.innerHTML = `
      <div class="row">
        <div><b>${niceDate(dateStr)}</b>${timeHtml}${correctedTag}</div>
        ${stampHtml}
      </div>
      ${permissionInfoHtml}
      ${locationHtml}
      ${rec.classUpdate ? `<div class="note-block" style="margin-top:10px; border-left:3px solid var(--ink-blue);"><div class="meta">Class Update</div><div>${escapeHtml(rec.classUpdate)}</div></div>` : ''}
      ${rec.voiceNote ? `
        <div class="note-block" style="margin-top:10px; border-left:3px solid var(--ink-blue);">
          <div class="meta">🎙 Teacher has sent a voice message</div>
          <audio controls src="${rec.voiceNote}"></audio>
          <div style="margin-top:6px;"><a class="link-btn" href="${rec.voiceNote}" download="${teacher.name.replace(/[^a-z0-9]+/gi,'_')}-${dateStr}-voicenote.${voiceNoteExt(rec.voiceNote)}">Download recording</a></div>
        </div>
      ` : ''}
      ${showNoUpdateWarning ? `<div class="muted" style="margin-top:8px;color:var(--ink-gold);">No update given — ${rec.exemptNoUpdateLate ? 'exempted from Late penalty (owner correction)' : 'counted as an extra Late for this day'}</div>` : ''}
      <div style="margin-top:10px;">
        ${locked
          ? `<span class="muted" style="font-size:11.5px;">🔒 Locked — unlock the month to correct this day</span>`
          : `<button class="link-btn" data-edit-day="${dateStr}">Edit / correct this day →</button>`
        }
      </div>
      <div id="editForm-${dateStr}" style="display:none; margin-top:10px;"></div>
      <div class="muted" style="margin-top:14px; font-size:11px; letter-spacing:0.5px;">DEDUCTIONS</div>
      <div id="notes-${dateStr}" style="margin-top:6px;"></div>
      <div class="mobile-stack-row" style="margin-top:8px; display:flex; gap:8px;">
        <input type="text" id="noteInput-${dateStr}" placeholder="Add a mistake note (₹200 will be deducted)" style="flex:1; min-width:0; padding:10px; min-height:44px; font-size:16px; border:1px solid var(--rule); background:#FBF6E6;" ${locked ? 'disabled' : ''}>
        <button class="btn danger" data-add-note="${dateStr}" ${locked ? 'disabled' : ''}>Add & Deduct ₹200</button>
      </div>
    `;
    content.appendChild(dayBlock);

    const notesHolder = dayBlock.querySelector(`#notes-${dateStr}`);
    (rec.ownerNotes || []).forEach(n=>{
      const nb = document.createElement('div');
      nb.className = 'note-block';
      nb.innerHTML = `<div class="meta">₹200 deducted</div><div>${escapeHtml(n.text)}</div>`;
      notesHolder.appendChild(nb);
    });

    // Owner correction panel — lets the owner fix any day's record directly:
    // change Present/Leave/Unmarked, set an arrival time, and optionally
    // exempt that day from the "missing class update = extra Late" rule.
    // Not available once the month is locked (see button above).
    const editDayBtn = dayBlock.querySelector(`[data-edit-day="${dateStr}"]`);
    if(editDayBtn) editDayBtn.onclick = ()=>{
      const formHolder = dayBlock.querySelector(`#editForm-${dateStr}`);
      if(formHolder.style.display === 'block'){ formHolder.style.display = 'none'; return; }
      const currentStatus = rec.dayType === 'leave' ? 'leave' : (rec.arrival ? 'present' : 'unmarked');
      const currentTime = rec.arrival ? (()=>{ const dt = new Date(rec.arrival); return `${pad(dt.getHours())}:${pad(dt.getMinutes())}`; })() : '';
      formHolder.innerHTML = `
        <div class="note-block" style="border-left:3px solid var(--ink-gold);">
          <div class="meta">Correct this day</div>
          <div class="field" style="margin-top:8px;">
            <label>Status</label>
            <select id="editStatus-${dateStr}">
              <option value="present" ${currentStatus==='present'?'selected':''}>Present</option>
              <option value="leave" ${currentStatus==='leave'?'selected':''}>Leave</option>
              <option value="unmarked" ${currentStatus==='unmarked'?'selected':''}>Unmarked (clear)</option>
            </select>
          </div>
          <div class="field" style="display:flex; align-items:center; gap:8px;">
            <input type="checkbox" id="editOnTime-${dateStr}" style="width:auto;">
            <label style="margin:0;" for="editOnTime-${dateStr}">Teacher came on time but forgot to check in on the app — mark On Time</label>
          </div>
          <div class="field" id="editTimeField-${dateStr}" style="${currentStatus==='present'?'':'display:none;'}">
            <label>Arrival time (leave blank for on-time)</label>
            <input type="time" id="editTime-${dateStr}" value="${currentTime}">
          </div>
          <div class="field" style="display:flex; align-items:center; gap:8px;">
            <input type="checkbox" id="editExempt-${dateStr}" ${rec.exemptNoUpdateLate ? 'checked' : ''} style="width:auto;">
            <label style="margin:0;" for="editExempt-${dateStr}">Don't count missing class update as Late for this day</label>
          </div>
          <div class="error-msg" id="editDayErr-${dateStr}"></div>
          <button class="btn" id="editDaySave-${dateStr}">Save Correction</button>
          <button class="btn secondary" id="editDayCancel-${dateStr}" style="margin-left:8px;">Cancel</button>
        </div>
      `;
      formHolder.style.display = 'block';

      const statusSel = formHolder.querySelector(`#editStatus-${dateStr}`);
      const timeField = formHolder.querySelector(`#editTimeField-${dateStr}`);
      const onTimeBox = formHolder.querySelector(`#editOnTime-${dateStr}`);
      const timeInputEl = formHolder.querySelector(`#editTime-${dateStr}`);
      statusSel.onchange = ()=>{
        timeField.style.display = statusSel.value === 'present' ? '' : 'none';
        if(statusSel.value !== 'present'){ onTimeBox.checked = false; }
      };
      // Quick "forgot to check in" shortcut: owner ticks this when the teacher
      // actually arrived on time but never opened the app to mark it. It forces
      // Status to Present and clears/locks the time field to on-time.
      onTimeBox.onchange = ()=>{
        if(onTimeBox.checked){
          statusSel.value = 'present';
          timeField.style.display = '';
          timeInputEl.value = '';
          timeInputEl.disabled = true;
        } else {
          timeInputEl.disabled = false;
        }
      };
      formHolder.querySelector(`#editDayCancel-${dateStr}`).onclick = ()=>{ formHolder.style.display = 'none'; };
      formHolder.querySelector(`#editDaySave-${dateStr}`).onclick = async ()=>{
        const status = statusSel.value;
        const exempt = formHolder.querySelector(`#editExempt-${dateStr}`).checked;
        const timeInput = formHolder.querySelector(`#editTime-${dateStr}`);
        const timeVal = onTimeBox.checked ? '' : (timeInput ? timeInput.value : '');
        const freshRec = await loadMonthRecord(teacher.id, monthKey);
        const preserved = freshRec[dateStr] || {};
        // Keep non-attendance fields (class update, voice note, owner notes) — only
        // the attendance-status fields get overwritten by the correction.
        const base = { classUpdate: preserved.classUpdate, voiceNote: preserved.voiceNote, ownerNotes: preserved.ownerNotes };
        let corrected;
        if(status === 'leave'){
          corrected = { ...base, dayType:'leave', markedByOwner:true, markedByOwnerAt:new Date().toISOString() };
        } else if(status === 'unmarked'){
          corrected = { ...base };
        } else {
          // Present — use the entered time, or default to the scheduled time
          // (i.e. exactly on time) if left blank.
          const sched = getScheduledMinutes(teacher, dateObj);
          let arrivalDate;
          if(timeVal){
            const [hh,mm] = timeVal.split(':').map(Number);
            arrivalDate = new Date(y, m-1, d, hh, mm);
          } else {
            arrivalDate = new Date(y, m-1, d, Math.floor(sched/60), sched%60);
          }
          const arrivalMin = arrivalDate.getHours()*60 + arrivalDate.getMinutes();
          const diff = arrivalMin - sched;
          const dayStatus = diff >= 1 ? 'Late' : 'Present';
          corrected = { ...base, arrival: arrivalDate.toISOString(), status: dayStatus, lateMinutes: Math.max(diff,0) };
        }
        corrected.exemptNoUpdateLate = exempt;
        corrected.ownerCorrected = true;
        corrected.ownerCorrectedAt = new Date().toISOString();
        freshRec[dateStr] = corrected;
        await saveMonthRecord(teacher.id, monthKey, freshRec);
        toast('Day corrected');
        renderOwnerTeacherDetail(content);
      };
    };

    dayBlock.querySelector(`[data-add-note="${dateStr}"]`).onclick = async ()=>{
      if(locked) return;
      const input = dayBlock.querySelector(`#noteInput-${dateStr}`);
      const text = input.value.trim();
      if(!text) return;
      const freshRec = await loadMonthRecord(teacher.id, monthKey);
      const dayRec = freshRec[dateStr] || {};
      dayRec.ownerNotes = dayRec.ownerNotes || [];
      dayRec.ownerNotes.push({ text, deduction:200, addedAt:new Date().toISOString() });
      freshRec[dateStr] = dayRec;
      await saveMonthRecord(teacher.id, monthKey, freshRec);
      toast('Note added — ₹200 deducted');
      renderOwnerTeacherDetail(content);
    };
  }
}

// A separate page — reached only via the "📋 View Class Updates" button on the
// teacher detail screen — that shows ONLY this teacher's class updates for the
// selected month (text + voice notes). No attendance stamps, salary, or other
// register details are shown here, so the owner can review just the updates.
async function renderOwnerClassUpdates(content){
  const teacher = state.teachers.find(t=>t.id===state.selectedTeacherForOwner);
  if(!teacher){ state.screen = 'ownerHome'; render(); return; }
  const now = new Date();
  const currentMonthKey = fmtMonthKey(now);
  if(!state.ownerViewMonth) state.ownerViewMonth = currentMonthKey;
  const monthKey = state.ownerViewMonth;
  const isCurrentMonth = monthKey === currentMonthKey;
  content.innerHTML = `<div class="muted">Loading…</div>`;
  const monthRec = await loadMonthRecord(teacher.id, monthKey);

  content.innerHTML = '';
  const topbar = document.createElement('div');
  topbar.className = 'topbar';
  topbar.innerHTML = `
    <div>
      <button class="link-btn" id="backToDetail">&larr; back to ${teacher.name}'s register</button>
      <div class="teacher-name" style="margin-top:6px;">Class Updates</div>
      <div class="muted">${teacher.name}</div>
    </div>
  `;
  content.appendChild(topbar);
  topbar.querySelector('#backToDetail').onclick = ()=>{ state.screen = 'ownerTeacherDetail'; render(); };

  const monthNav = document.createElement('div');
  monthNav.className = 'today-card';
  monthNav.innerHTML = `
    <div class="row">
      <div style="display:flex; align-items:center; gap:6px; flex-wrap:wrap;">
        <button class="link-btn" id="prevMonthBtnU">← Previous month</button>
        <div class="teacher-name" style="font-size:14px; margin:0 4px;">${monthLabel(monthKey)}</div>
        ${!isCurrentMonth ? `<button class="link-btn" id="nextMonthBtnU">Next month →</button>` : ''}
      </div>
    </div>
  `;
  content.appendChild(monthNav);
  monthNav.querySelector('#prevMonthBtnU').onclick = ()=>{ state.ownerViewMonth = shiftMonthKey(monthKey, -1); renderOwnerClassUpdates(content); };
  const nextBtnU = monthNav.querySelector('#nextMonthBtnU');
  if(nextBtnU) nextBtnU.onclick = ()=>{ state.ownerViewMonth = shiftMonthKey(monthKey, 1); renderOwnerClassUpdates(content); };

  const updateEntries = [];
  const days2 = isCurrentMonth ? now.getDate() : daysInMonth(monthKey);
  const [y2,m2] = monthKey.split('-').map(Number);
  for(let d=days2; d>=1; d--){
    const dateObj2 = new Date(y2, m2-1, d);
    if(dateObj2 > now) continue;
    const sched2 = getScheduledMinutes(teacher, dateObj2);
    if(sched2 === null) continue;
    const dateStr2 = fmtDate(dateObj2);
    const rec2 = monthRec[dateStr2];
    const hasText = rec2 && rec2.classUpdate && rec2.classUpdate.trim();
    const hasVoice = rec2 && !!rec2.voiceNote;
    if(hasText || hasVoice) updateEntries.push({ dateStr: dateStr2, text: hasText ? rec2.classUpdate : '', voiceNote: hasVoice ? rec2.voiceNote : null });
  }

  const listWrap = document.createElement('div');
  if(updateEntries.length){
    listWrap.innerHTML = updateEntries.map(e => `
      <div class="today-card" style="margin-top:12px;">
        <div class="row"><b>${niceDate(e.dateStr)}</b></div>
        ${e.text ? `<div class="note-block" style="margin-top:10px; border-left:3px solid var(--ink-blue);"><div class="meta">Class Update</div><div>${escapeHtml(e.text)}</div></div>` : '<div class="muted" style="margin-top:8px;">(no text — voice note only)</div>'}
        ${e.voiceNote ? `
          <div class="note-block" style="margin-top:10px; border-left:3px solid var(--ink-blue);">
            <div class="meta">🎙 Voice message</div>
            <audio controls src="${e.voiceNote}"></audio>
            <div style="margin-top:6px;"><a class="link-btn" href="${e.voiceNote}" download="${teacher.name.replace(/[^a-z0-9]+/gi,'_')}-${e.dateStr}-voicenote.${voiceNoteExt(e.voiceNote)}">Download recording</a></div>
          </div>
        ` : ''}
      </div>
    `).join('');
  } else {
    listWrap.innerHTML = `<div class="today-card" style="margin-top:12px;"><div class="muted">No class updates from ${teacher.name} yet ${isCurrentMonth ? 'this month' : `in ${monthLabel(monthKey)}`}.</div></div>`;
  }
  content.appendChild(listWrap);
}

// Renders a small "At Tuition" / "Remote" badge with a map link, for a saved location object.
function locationBadgeHtml(location){
  if(!location) return `<span class="muted" style="font-size:11px;">location not shared</span>`;
  const mapUrl = `https://www.google.com/maps?q=${location.lat},${location.lng}`;
  let tag = '';
  if(location.atTuition === true) tag = `<span class="stamp present" style="font-size:10.5px; padding:3px 8px;">AT TUITION</span>`;
  else if(location.atTuition === false) tag = `<span class="stamp late" style="font-size:10.5px; padding:3px 8px;">REMOTE (${location.distanceMeters}m away)</span>`;
  return `${tag} <a href="${mapUrl}" target="_blank" rel="noopener" class="muted" style="font-size:11px; text-decoration:underline;">view on map</a>`;
}

// Voice notes are saved as data URIs (data:audio/<mime>;base64,....). Pick a
// reasonable file extension from that mime type so the owner's downloaded
// file plays correctly (iPhone recordings are mp4/aac, others webm/ogg).
function voiceNoteExt(dataUri){
  const m = /^data:audio\/([a-zA-Z0-9.+-]+)/.exec(dataUri || '');
  if(!m) return 'audio';
  const mime = m[1].split(';')[0].toLowerCase();
  if(mime === 'mp4' || mime === 'aac') return 'm4a';
  if(mime === 'ogg') return 'ogg';
  if(mime === 'webm') return 'webm';
  return mime || 'audio';
}

// Builds a password/PIN <input> wrapped with a 👁 toggle button that reveals
// the typed characters. `extraAttrs` is any extra HTML attributes string
// (inputmode, maxlength, placeholder, value, etc.) to put on the input.
function pinInputHtml(id, extraAttrs){
  return `<div class="pin-wrap">
    <input type="password" id="${id}" ${extraAttrs||''}>
    <button type="button" class="pin-eye" data-toggle="${id}" aria-label="Show/hide">👁</button>
  </div>`;
}

// Call once after rendering a screen that used pinInputHtml, so its eye
// buttons actually toggle the paired input between hidden and visible text.
function wirePinEyes(root){
  root.querySelectorAll('.pin-eye').forEach(btn=>{
    btn.onclick = ()=>{
      const input = root.querySelector('#'+btn.dataset.toggle);
      if(!input) return;
      if(input.type === 'password'){ input.type = 'text'; btn.textContent = '🙈'; }
      else { input.type = 'password'; btn.textContent = '👁'; }
    };
  });
}

function escapeHtml(str){
  const d = document.createElement('div');
  d.textContent = str;
  return d.innerHTML;
}

// Builds one PDF: page 1 is the overall register (every teacher's monthly
// summary — the same numbers shown on the Owner Desk table), followed by one
// page per teacher with their full day-by-day personal attendance log.
async function downloadAttendancePdf(rows, monthKey){
  if(!window.jspdf || !window.jspdf.jsPDF){
    toast('PDF library still loading — try again in a moment');
    return;
  }
  const { jsPDF } = window.jspdf;
  const docPdf = new jsPDF({ unit:'pt', format:'a4' });
  const marginX = 40;
  const now = new Date();
  const generatedAt = now.toLocaleString('en-IN');

  docPdf.setFont('helvetica', 'bold');
  docPdf.setFontSize(16);
  docPdf.text('The Attendance Register', marginX, 50);
  docPdf.setFont('helvetica', 'normal');
  docPdf.setFontSize(10);
  docPdf.text(`Overall register - ${monthLabel(monthKey)}`, marginX, 68);
  docPdf.text(`Generated ${generatedAt}`, marginX, 82);

  const overallBody = rows.map(({teacher, stats})=>{
    const total = teacher.dailySalary
      ? `Rs ${(stats.autoDeductDays + stats.permissionHalfDays) * teacher.dailySalary + stats.ownerDeductionRupees}`
      : ((stats.autoDeductDays > 0 || stats.permissionHalfDays > 0) ? 'set salary' : 'Rs 0');
    return [
      teacher.name,
      `${stats.lateCount}/${FREE_LATES}${stats.lateDeductDays ? ' (-'+stats.lateDeductDays+'d)' : ''}`,
      `${stats.permissionCount}/${FREE_PERMISSIONS}${stats.permissionHalfDays ? ' (-'+stats.permissionHalfDays+'d)' : ''}`,
      `${stats.leaveCount}/${FREE_LEAVES}${stats.leaveDeductDays ? ' (-'+stats.leaveDeductDays+'d)' : ''}`,
      String(stats.otherStrikes),
      `Rs ${stats.ownerDeductionRupees}`,
      total
    ];
  });

  docPdf.autoTable({
    startY: 96,
    head: [['Teacher','Late','Permission','Leave','Absent','Owner notes','Total to deduct']],
    body: overallBody,
    styles:{ fontSize:8, cellPadding:4 },
    headStyles:{ fillColor:[47,71,54] },
    margin:{ left:marginX, right:marginX }
  });

  const [y,m] = monthKey.split('-').map(Number);
  const totalDays = fmtMonthKey(now) === monthKey ? now.getDate() : daysInMonth(monthKey);

  for(const {teacher, monthRec} of rows){
    docPdf.addPage();
    docPdf.setFont('helvetica', 'bold');
    docPdf.setFontSize(13);
    docPdf.text(`${teacher.name} - Personal Attendance - ${monthLabel(monthKey)}`, marginX, 50);
    docPdf.setFont('helvetica', 'normal');
    docPdf.setFontSize(9);
    docPdf.text(`Timing: ${scheduleLabel(teacher)}`, marginX, 66);

    const body = [];
    for(let d=totalDays; d>=1; d--){
      const dateObj = new Date(y, m-1, d);
      if(dateObj > now) continue;
      const sched = getScheduledMinutes(teacher, dateObj);
      if(sched === null) continue; // Sunday
      const dateStr = fmtDate(dateObj);
      const rec = monthRec[dateStr] || {};
      let statusStr = 'Absent';
      let timeStr = '-';
      let detailsStr = '';
      if(rec.dayType === 'leave'){
        statusStr = 'Leave';
      } else if(rec.dayType === 'permission'){
        statusStr = rec.arrival ? `Permission / ${rec.status}` : 'Permission (not arrived)';
        if(rec.arrival) timeStr = fmtTime(new Date(rec.arrival));
        detailsStr = `+${rec.permissionMinutes||0}m${rec.permissionReason ? ' - '+rec.permissionReason : ''} (informed: ${rec.permissionInformed?'yes':'no'})`;
      } else if(rec.arrival){
        statusStr = rec.status;
        timeStr = fmtTime(new Date(rec.arrival));
        if(rec.status === 'Late') detailsStr = `${rec.lateMinutes} min late`;
      }
      const notesCount = (rec.ownerNotes||[]).length;
      const notesStr = notesCount ? `${notesCount} note(s), Rs ${notesCount*200}` : '';
      // The PDF never embeds the actual audio — only a text marker that a
      // voice note exists. The recording itself stays in Firestore and is
      // downloadable separately by the owner from the app (see the
      // "Download" link next to each audio player in Owner Desk).
      let classUpdateStr = (rec.classUpdate && rec.classUpdate.trim()) ? rec.classUpdate.trim() : '';
      if(rec.voiceNote){
        classUpdateStr = classUpdateStr ? `${classUpdateStr}\n[Teacher has sent a voice message]` : '[Teacher has sent a voice message]';
      }
      body.push([ niceDate(dateStr), statusStr, timeStr, detailsStr, classUpdateStr, notesStr ]);
    }

    docPdf.autoTable({
      startY: 80,
      head: [['Date','Status','Time','Details','Class Update','Owner Notes']],
      body,
      styles:{ fontSize:8, cellPadding:4 },
      headStyles:{ fillColor:[47,71,54] },
      columnStyles:{ 4:{ cellWidth:120 } },
      margin:{ left:marginX, right:marginX }
    });
  }

  docPdf.save(`attendance-${monthKey}.pdf`);
}

async function init(){
  await loadTeachers();
  state.sundayClasses = await loadSundayClasses();
  state.lockedMonths = await loadLockedMonths();
  state.screen = 'role';
  render();
  // Dismiss splash: wait a beat so the app behind is ready, then fade out
  const splash = document.getElementById('splash');
  if(splash){
    setTimeout(()=>{
      splash.classList.add('fade-out');
      splash.addEventListener('transitionend', ()=> splash.remove(), { once:true });
    }, 1480);
  }
}
init();
