      <div class="quota-box ${stats.permissionCount > FREE_PERMISSIONS ? 'over' : ''}"><div class="q-num">${stats.permissionCount} / ${FREE_PERMISSIONS}${stats.permissionHalfDays ? ` (-${stats.permissionHalfDays}d)` : ''}</div><div class="q-lbl">Permission used</div></div>
      <div class="quota-box ${stats.leaveCount > FREE_LEAVES ? 'over' : ''}"><div class="q-num">${stats.leaveCount} / ${FREE_LEAVES}</div><div class="q-lbl">Leave used</div></div>
    </div>
    <div class="muted" style="margin-top:8px; font-size:11.5px;">Past your free lates, every 3 more lates = 1 day's salary lost. The 1st Permission each month is free — every Permission after that costs half a day's salary. Past the 1 free Leave, each extra Leave used = 1 full day's salary lost.</div>
  `;
  content.appendChild(summary);
