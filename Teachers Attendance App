<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Attendance">
<meta name="theme-color" content="#223327">
<title>Register — Tuition Attendance</title>
<link rel="icon" type="image/png" href="data:image/png;base64,">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Special+Elite&family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
<style>
  :root{
    --cover: #2F4736;
    --cover-dark: #223327;
    --page: #EFE6C8;
    --page-dark: #E3D7AE;
    --rule: #C9BB8C;
    --ink-blue: #2B3A67;
    --ink-red: #A5342B;
    --ink-gold: #9A7429;
    --text: #2A2620;
    --text-soft: #6b6350;
    --shadow: rgba(43,32,10,0.25);
    --logo-watermark: url('data:image/png;base64,');
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  html{ -webkit-text-size-adjust:100%; text-size-adjust:100%; }
  body{
    background: var(--cover);
    background-image:
      radial-gradient(circle at 20% 10%, rgba(255,255,255,0.03), transparent 40%),
      repeating-linear-gradient(90deg, rgba(0,0,0,0.05) 0 1px, transparent 1px 40px);
    min-height:100vh;
    font-family:'Lora', serif;
    color: var(--text);
    padding: 18px;
    padding-left: max(18px, env(safe-area-inset-left));
    padding-right: max(18px, env(safe-area-inset-right));
    padding-bottom: max(18px, env(safe-area-inset-bottom));
    overflow-x: hidden;
  }
  button, .btn, .link-btn, .tab, select, input, a{ touch-action: manipulation; }
  .register{
    max-width: 880px;
    margin: 0 auto;
    background: var(--page);
    border-radius: 6px;
    box-shadow: 0 20px 50px var(--shadow), 0 2px 0 var(--cover-dark);
    position:relative;
    overflow:hidden;
    min-height: 640px;
    border: 1px solid var(--rule);
  }
  .register::before{
    content:"";
    position:absolute; top:0; left:0; right:0; height:14px;
    background: var(--cover-dark);
    z-index: 2;
  }
  .register::after{
    content:"";
    position:absolute;
    top:0; left:0; right:0; bottom:0;
    background-image: var(--logo-watermark);
    background-repeat: no-repeat;
    background-position: center 54%;
    background-size: 340px 195px;
    opacity: 0.42;
    pointer-events: none;
    z-index: 0;
  }
  header.masthead, .content{
    position: relative;
    z-index: 1;
  }
  .spine-tab{
    position:absolute; top:26px; right:28px;
    font-family:'Special Elite', monospace;
    font-size:11px; letter-spacing:2px;
    color: var(--cover-dark); opacity:0.55;
  }
  header.masthead{
    padding: 34px 34px 18px;
    border-bottom: 2px solid var(--rule);
    display:flex; align-items:baseline; justify-content:space-between; gap:12px; flex-wrap:wrap;
  }
  header.masthead h1{
    font-family:'Special Elite', monospace;
    font-size: 26px;
    margin:0;
    color: var(--cover-dark);
    letter-spacing: 0.5px;
  }
  header.masthead .sub{
    font-size: 12.5px; color: var(--text-soft); font-style: italic;
  }
  .content{ padding: 26px 34px 40px; }

  /* ruled lines effect for panels */
  .ledger{
    background-image: repeating-linear-gradient(
      to bottom, transparent, transparent 37px, var(--rule) 38px
    );
  }

  button{
    font-family:'IBM Plex Mono', monospace;
    cursor:pointer;
    border-radius: 3px;
  }
  input, select, textarea{
    font-family:'Lora', serif;
    border-radius: 3px;
  }

  .btn{
    background: var(--cover);
    color: var(--page);
    border: 1px solid var(--cover-dark);
    padding: 12px 18px;
    min-height: 44px;
    font-size: 13.5px;
    letter-spacing: 0.5px;
    transition: transform .12s ease, box-shadow .12s ease;
  }
  .btn:hover{ transform: translateY(-1px); box-shadow: 0 4px 10px rgba(0,0,0,0.2); }
  .btn:active{ transform: translateY(0); }
  .btn.secondary{
    background: transparent; color: var(--cover-dark); border: 1px solid var(--cover-dark);
  }
  .btn.danger{ background: var(--ink-red); border-color:#7a241d; }
  .btn:disabled{ opacity:0.45; cursor:not-allowed; transform:none; box-shadow:none; }

  .field{ margin-bottom: 16px; }
  .field label{ display:block; font-size: 12px; color: var(--text-soft); margin-bottom:5px; letter-spacing:0.3px;}
  .field input, .field select, .field textarea{
    width:100%; padding: 12px 12px; min-height:44px; border:1px solid var(--rule); background: #FBF6E6; font-size:16px; color: var(--text);
  }
  .field textarea{ resize: vertical; min-height: 70px; }

  .pin-wrap{ position:relative; }
  .pin-wrap input{ padding-right:38px; }
  .pin-eye{
    position:absolute; right:6px; top:50%; transform:translateY(-50%);
    background:none; border:none; cursor:pointer; font-size:16px; line-height:1;
    padding:6px; color: var(--text-soft);
  }
  .pin-eye:hover{ color: var(--text); }

  .role-choice{ display:flex; gap:16px; flex-wrap:wrap; justify-content:center; margin-top: 30px; }
  .role-card{
    flex:1; min-width:220px; max-width:280px; background:#FBF6E6; border:1px solid var(--rule);
    padding: 26px 20px; text-align:center; cursor:pointer; transition: box-shadow .15s ease, transform .15s ease;
  }
  .role-card:hover{ box-shadow: 0 8px 18px rgba(0,0,0,0.12); transform: translateY(-2px); }
  .role-card .icon{ font-size: 30px; margin-bottom: 10px; }
  .role-card h3{ font-family:'Special Elite', monospace; font-size:15px; margin: 0 0 6px; color: var(--cover-dark); }
  .role-card p{ font-size:12.5px; color: var(--text-soft); margin:0; }

  .stamp{
    display:inline-flex; align-items:center; justify-content:center;
    font-family:'Special Elite', monospace;
    font-size: 12px; letter-spacing:1.5px;
    padding: 5px 12px;
    border: 2px solid currentColor;
    border-radius: 4px;
    transform: rotate(-3deg);
    text-transform:uppercase;
  }
  .stamp.present{ color: var(--ink-blue); }
  .stamp.late{ color: var(--ink-red); }
  .stamp.pending{ color: var(--text-soft); border-style:dashed; }
  .stamp.noupdate{ color: var(--ink-gold); }
  .stamp.permission{ color: var(--ink-gold); }
  .stamp.leave{ color: #5B7A47; }

  .quota-grid{ display:grid; grid-template-columns: repeat(auto-fit,minmax(110px,1fr)); gap:10px; margin-top:12px; }
  .quota-box{ background:#FBF6E6; border:1px solid var(--rule); padding:10px 12px; text-align:center; }
  .quota-box .q-num{ font-family:'IBM Plex Mono', monospace; font-size:16px; color: var(--cover-dark); }
  .quota-box .q-lbl{ font-size:10.5px; color: var(--text-soft); margin-top:2px; }
  .quota-box.over .q-num{ color: var(--ink-red); }

  .today-card{
    background:#FBF6E6; border:1px solid var(--rule); padding: 24px; margin-bottom: 24px;
  }
  .today-card .row{ display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap; }
  .teacher-name{ font-family:'Special Elite', monospace; font-size:17px; color: var(--cover-dark); }
  .muted{ color: var(--text-soft); font-size:12.5px; }
  .time-big{ font-family:'IBM Plex Mono', monospace; font-size: 20px; color: var(--ink-blue); }

  .table-scroll{ width:100%; overflow-x:auto; -webkit-overflow-scrolling:touch; }
  table{ width:100%; border-collapse: collapse; font-size: 13px; }
  th, td{ text-align:left; padding: 9px 8px; border-bottom: 1px solid var(--rule); vertical-align: top;}
  th{ font-family:'IBM Plex Mono', monospace; font-size:11px; letter-spacing:0.5px; color: var(--text-soft); text-transform:uppercase; }
  tr:hover td{ background: rgba(255,255,255,0.35); }

  /* On phones, the owner's wide summary table turns into a stack of cards —
     one card per teacher, each row's data shown as a label:value line —
     instead of squeezing 11 columns into a narrow screen. */
  @media (max-width:760px){
    table.responsive-table{ font-size:13px; }
    table.responsive-table thead{ display:none; }
    table.responsive-table, table.responsive-table tbody,
    table.responsive-table tr, table.responsive-table td{ display:block; width:100%; }
    table.responsive-table tr{
      margin-bottom:14px; border:1px solid var(--rule); border-radius:6px;
      padding:4px 12px; background:#FBF6E6;
    }
    table.responsive-table td{
      border-bottom:1px dashed var(--rule); padding:9px 0;
      display:flex; justify-content:space-between; align-items:flex-start; gap:12px;
    }
    table.responsive-table td:last-child{ border-bottom:none; }
    table.responsive-table td::before{
      content: attr(data-label);
      font-family:'IBM Plex Mono', monospace; font-size:10px; letter-spacing:0.5px;
      text-transform:uppercase; color: var(--text-soft); flex-shrink:0; padding-top:2px;
    }
    table.responsive-table td[data-label=""]::before{ display:none; }
  }

  .topbar{ display:flex; justify-content:space-between; align-items:center; margin-bottom: 18px; flex-wrap:wrap; gap:10px;}
  .owner-actions{ display:flex; flex-wrap:wrap; align-items:center; }
  .owner-actions .sep{ margin:0 6px; color:var(--rule); }
  .tabs{ display:flex; gap:6px; flex-wrap:wrap; margin-bottom:18px; }
  .tab{
    font-family:'IBM Plex Mono', monospace; font-size:11.5px; padding:7px 12px;
    background: var(--page-dark); border:1px solid var(--rule); cursor:pointer; color:var(--text-soft);
  }
  .tab.active{ background: var(--cover); color: var(--page); border-color: var(--cover-dark); }

  .summary-grid{ display:grid; grid-template-columns: repeat(auto-fit,minmax(150px,1fr)); gap:12px; margin: 16px 0 22px; }
  .summary-box{ background:#FBF6E6; border:1px solid var(--rule); padding:14px 16px; }
  .summary-box .num{ font-family:'IBM Plex Mono', monospace; font-size:22px; color: var(--cover-dark); }
  .summary-box .lbl{ font-size:11.5px; color: var(--text-soft); margin-top:2px; }

  .note-block{ background:#FBF6E6; border:1px solid var(--rule); padding:12px 14px; margin-top:8px;}
  .note-block .meta{ font-size:11px; color:var(--text-soft); margin-bottom:4px; }

  .link-btn{ background:none; border:none; color: var(--ink-blue); text-decoration:underline; font-family:'Lora',serif; font-size:12.5px; padding:6px 0; display:inline-block; }

  .error-msg{ color: var(--ink-red); font-size:12.5px; margin-top:6px; }
  .toast{
    position:fixed; bottom:20px; left:50%; transform:translateX(-50%);
    background: var(--cover-dark); color:#fff; padding:10px 18px; border-radius:4px; font-size:13px;
    box-shadow:0 6px 16px rgba(0,0,0,0.3); opacity:0; pointer-events:none; transition: opacity .25s ease;
    font-family:'IBM Plex Mono', monospace; z-index:50;
  }
  .toast.show{ opacity:1; }

  audio{ width:100%; margin-top:6px; }
  .rec-dot{ display:inline-block; width:9px; height:9px; border-radius:50%; background:var(--ink-red); margin-right:6px; animation: pulse 1s infinite; }
  @keyframes pulse{ 0%,100%{opacity:1;} 50%{opacity:0.3;} }

  @media (max-width:600px){
    body{ padding:10px; }
    .register{ border-radius:4px; min-height:0; }
    header.masthead{ padding:20px 16px 12px; gap:8px; }
    .content{ padding:16px 16px 28px; }
    header.masthead h1{ font-size:18px; }
    header.masthead .logo-badge{ width:76px !important; height:44px !important; }
    header.masthead .sub{ font-size:11px; }
    .spine-tab{ display:none; }
    .today-card{ padding:16px; }
    .role-choice{ flex-direction:column; align-items:stretch; }
    .role-card{ max-width:none; }
    .btn{ width:100%; }
    .btn + .btn{ margin-left:0 !important; margin-top:8px; }
    .today-card .row > .btn, .today-card .row > .btn.secondary{ width:auto; }
    .owner-actions{ flex-direction:column; align-items:flex-start; gap:2px; }
    .owner-actions .sep{ display:none; }
    .mobile-stack-row{ flex-direction:column; align-items:stretch !important; }
    .mobile-stack-row input{ width:100%; }
    .mobile-stack-row .btn{ width:100%; }
    .quota-grid, .summary-grid{ grid-template-columns: repeat(auto-fit,minmax(130px,1fr)); }
  }

  /* ── Splash Screen ───────────────────────────────────────────────────── */
  #splash{
    position:fixed; inset:0; z-index:9999;
    background: var(--cover-dark);
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    gap:0;
    pointer-events:all;
    transition: opacity 0.55s ease, transform 0.55s ease;
  }
  #splash.fade-out{
    opacity:0;
    transform: scale(1.025);
    pointer-events:none;
  }
  #splash-logo{
    width:130px; height:76px;
    background-image: var(--logo-watermark);
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    background-color: #fff;
    border-radius:14px;
    box-shadow: 0 6px 28px rgba(0,0,0,0.45), 0 2px 0 rgba(255,255,255,0.08);
    opacity:0;
    transform: scale(0.72);
    animation: splashLogoIn 0.65s cubic-bezier(0.22,1,0.36,1) 0.15s forwards;
  }
  #splash-name{
    font-family:'Special Elite', monospace;
    font-size:22px;
    letter-spacing:1.5px;
    color: var(--page);
    margin-top:22px;
    opacity:0;
    transform: translateY(10px);
    animation: splashNameIn 0.5s ease 0.72s forwards;
  }
  #splash-tagline{
    font-family:'Lora', serif;
    font-size:12.5px;
    font-style:italic;
    color: rgba(239,230,200,0.55);
    margin-top:7px;
    opacity:0;
    animation: splashTagIn 0.4s ease 1.05s forwards;
  }
  #splash-bar{
    width:48px; height:2px;
    background: var(--rule);
    border-radius:2px;
    margin-top:24px;
    opacity:0;
    animation: splashTagIn 0.4s ease 1.15s forwards;
  }
  @keyframes splashLogoIn{
    to{ opacity:1; transform:scale(1); }
  }
  @keyframes splashNameIn{
    to{ opacity:1; transform:translateY(0); }
  }
  @keyframes splashTagIn{
    to{ opacity:1; }
  }
  /* ── End Splash ──────────────────────────────────────────────────────── */
</style>
</head>
<body>
<div id="splash">
  <div id="splash-logo"></div>
  <div id="splash-name">The Attendance Register</div>
  <div id="splash-tagline">daily entries, kept honestly</div>
  <div id="splash-bar"></div>
</div>
<div id="fbErrorBanner" style="display:none; max-width:880px; margin:0 auto 10px; background:#5a1f1f; color:#fdeaea; border:1px solid #8a2c2c; border-radius:6px; padding:12px 16px; font-family:'IBM Plex Mono',monospace; font-size:12.5px; line-height:1.5;">
  ⚠️ <b>Could not connect to the shared database.</b> Check your internet connection and reload. Until reconnected, changes may only save on this device.
</div>
<div class="register" id="app"></div>
<div class="toast" id="toast"></div>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/12.16.0/firebase-app.js";
import { getFirestore, doc, getDoc, setDoc, collection, getDocs, deleteDoc } from "https://www.gstatic.com/firebasejs/12.16.0/firebase-firestore.js";

const STORAGE_TEACHERS_KEY = 'teachers-v1';
const STORAGE_OWNER_KEY = 'owner-auth-v1';
const STORAGE_CENTER_KEY = 'tuition-center-v1';
const STORAGE_SUNDAY_KEY = 'sunday-classes-v1'; // { "YYYY-MM-DD": "HH:MM" } — owner-set one-off Sunday class timings
const NEAR_TUITION_METERS = 300; // within this distance counts as "at tuition"

const firebaseConfig = {
  apiKey: "AIzaSyA5nOouWTr_dtYbNR84iBc8PPzZNqKnuqE",
  authDomain: "attendance-register-831b6.firebaseapp.com",
  projectId: "attendance-register-831b6",
  storageBucket: "attendance-register-831b6.firebasestorage.app",
  messagingSenderId: "8234670862",
  appId: "1:8234670862:web:36af9ef52c91ff5d15555f",
  measurementId: "G-RDLBDEZYLE"
};
const fbApp = initializeApp(firebaseConfig);
const db = getFirestore(fbApp);
const FIRESTORE_COLLECTION = 'attendance_data';

function fbDocId(key){ return key.replace(/\//g, '_'); }
function showFbError(show){
  const b = document.getElementById('fbErrorBanner');
  if(b) b.style.display = show ? 'block' : 'none';
}

// Firestore is the shared source of truth (every teacher's phone + the owner
// all read/write the same project). A small localStorage cache is kept purely
// so the last-loaded data still shows if the phone briefly loses internet —
// it is NOT a substitute for Firestore and is never treated as authoritative.
async function appStorageGet(key, shared){
  try{
    const snap = await getDoc(doc(db, FIRESTORE_COLLECTION, fbDocId(key)));
    if(!snap.exists()) throw new Error('not found');
    const value = snap.data().value;
    showFbError(false);
    try{ localStorage.setItem('reg-' + key, value); }catch(e){}
    return { key, value, shared };
  }catch(e){
    const raw = (()=>{ try{ return localStorage.getItem('reg-' + key); }catch(e2){ return null; } })();
    if(raw !== null){ showFbError(true); return { key, value: raw, shared }; }
    throw e;
  }
}
async function appStorageSet(key, value, shared){
  try{ localStorage.setItem('reg-' + key, value); }catch(e){}
  await setDoc(doc(db, FIRESTORE_COLLECTION, fbDocId(key)), { value, updatedAt: new Date().toISOString() });
  showFbError(false);
  return { key, value, shared };
}

const DEFAULT_TEACHERS = [
  { id:'padma',    name:'Padma Priya Mam', pin:null, dailySalary:null, schedule:{ weekday:'16:45', saturday:'17:15' } },
  { id:'sancia',   name:'Sancia Mam',      pin:null, dailySalary:null, schedule:{ weekday:'16:45', saturday:'17:15' } },
  { id:'niranjan', name:'Niranjan Sir',    pin:null, dailySalary:null, schedule:{ weekday:'17:30', saturday:'17:30' } },
  { id:'jothi',    name:'Jothi Basker Sir',pin:null, dailySalary:null, schedule:{ weekday:'17:30', saturday:'17:30' } },
  { id:'mubena',   name:'Mubena Mam',      pin:null, dailySalary:null, schedule:{ weekday:'17:30', saturday:'17:30' } },
  { id:'mariya',   name:'Mariya Mam',      pin:null, dailySalary:null, schedule:{ weekday:'18:45', saturday:'18:45' } },
];

let state = {
  screen: 'loading',       // loading | role | teacherLogin | teacherPinSetup | ownerLogin | ownerPinSetup | teacherHome | ownerHome | ownerTeacherDetail
  teachers: [],
  currentTeacherId: null,
  ownerAuthed: false,
  selectedTeacherForOwner: null,
  monthCache: {},          // teacherId:YYYY-MM -> record object
  recording: null,         // MediaRecorder in progress state
  sundayClasses: {},       // "YYYY-MM-DD" -> "HH:MM", owner-set one-off Sunday class timings — same timing applies to every teacher that day
  ownerViewMonth: null,    // "YYYY-MM" the owner is currently browsing (Owner Desk + per-teacher register). Defaults to the current month.
  lockedMonths: [],        // ["YYYY-MM", ...] months the owner has settled salary for and locked from further edits
};

function toast(msg){
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(()=>t.classList.remove('show'), 2200);
}

function pad(n){ return n.toString().padStart(2,'0'); }
function fmtDate(d){ return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`; }
function fmtMonthKey(d){ return `${d.getFullYear()}-${pad(d.getMonth()+1)}`; }
function fmtTime(d){
  let h = d.getHours(), m = d.getMinutes();
  const ampm = h >= 12 ? 'PM' : 'AM';
  h = h % 12; if(h===0) h = 12;
  return `${h}:${pad(m)} ${ampm}`;
}
function niceDate(dateStr){
  const d = new Date(dateStr + 'T00:00:00');
  return d.toLocaleDateString('en-IN', { weekday:'short', day:'numeric', month:'short' });
}
function monthLabel(monthKey){
  const [y,m] = monthKey.split('-');
  const d = new Date(parseInt(y), parseInt(m)-1, 1);
  return d.toLocaleDateString('en-IN', { month:'long', year:'numeric' });
}
function daysInMonth(monthKey){
  const [y,m] = monthKey.split('-').map(Number);
  return new Date(y, m, 0).getDate();
}

async function loadTeachers(){
  try{
    const res = await appStorageGet(STORAGE_TEACHERS_KEY, true);
    state.teachers = JSON.parse(res.value);
    // Backfill dailySalary for teachers saved before this field existed.
    state.teachers.forEach(t=>{ if(!('dailySalary' in t)) t.dailySalary = null; });
  }catch(e){
    state.teachers = DEFAULT_TEACHERS;
    try{ await appStorageSet(STORAGE_TEACHERS_KEY, JSON.stringify(DEFAULT_TEACHERS), true); }catch(e2){}
  }
}
async function saveTeachers(){
  try{ await appStorageSet(STORAGE_TEACHERS_KEY, JSON.stringify(state.teachers), true); }
  catch(e){ toast('Could not save — try again'); }
}

async function loadOwnerAuth(retries=2){
  for(let i=0;i<=retries;i++){
    try{
      const res = await appStorageGet(STORAGE_OWNER_KEY, true);
      const parsed = JSON.parse(res.value);
      if(parsed && typeof parsed.pass === 'string') return parsed;
      return null;
    }catch(e){
      if(i === retries) return null;
      await new Promise(r=>setTimeout(r, 300));
    }
  }
  return null;
}
// Saves the owner password and reads it back to confirm it actually persisted.
// Returns true only if a verified round-trip succeeded.
async function saveOwnerAuth(pass){
  try{
    await appStorageSet(STORAGE_OWNER_KEY, JSON.stringify({ pass }), true);
    const check = await loadOwnerAuth(1);
