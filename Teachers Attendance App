// Month-key arithmetic for the owner's Previous/Next month navigation.
function shiftMonthKey(monthKey, delta){
  const [y,m] = monthKey.split('-').map(Number);
  const d = new Date(y, m-1+delta, 1);
  return fmtMonthKey(d);
}
function fmtTimeStr(t){
  let [h,m] = t.split(':').map(Number);
  const ampm = h>=12?'PM':'AM'; h = h%12; if(h===0) h=12;
  return `${h}:${pad(m)} ${ampm}`;
}

// Straight-line distance between two lat/lng points, in meters (Haversine formula).
function distanceMeters(lat1, lng1, lat2, lng2){
  const R = 6371000;
  const toRad = d => d * Math.PI / 180;
  const dLat = toRad(lat2 - lat1);
  const dLng = toRad(lng2 - lng1);
  const a = Math.sin(dLat/2)**2 + Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLng/2)**2;
  return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
}

// Asks the browser for the device's current GPS position.
// Resolves to null (never rejects) if denied, unsupported, or timed out —
// attendance marking must still work even without location.
// getCurrentLocation() itself still just returns null on any failure (unchanged
// contract for existing callers); getCurrentLocationWithReason() is the same
// check but also tells you *why* it failed, for a clearer message to the user.
function getCurrentLocationWithReason(){
  return new Promise((resolve)=>{
    if(window.isSecureContext === false){ resolve({ pos:null, reason:'insecure-page' }); return; }
    if(!navigator.geolocation){ resolve({ pos:null, reason:'unsupported' }); return; }
    navigator.geolocation.getCurrentPosition(
      pos => resolve({ pos: { lat: pos.coords.latitude, lng: pos.coords.longitude, accuracy: pos.coords.accuracy }, reason:null }),
      err => resolve({ pos:null, reason: err && err.code === err.PERMISSION_DENIED ? 'denied' : (err && err.code === err.TIMEOUT ? 'timeout' : 'unknown') }),
      { enableHighAccuracy: true, timeout: 8000, maximumAge: 60000 }
    );
  });
}
function getCurrentLocation(){
  return getCurrentLocationWithReason().then(r => r.pos);
}
function locationFailureMessage(reason){
  switch(reason){
    case 'insecure-page': return 'location not available — open this app from its https:// link, not a downloaded/shared file';
    case 'denied': return 'location not available — permission denied';
    case 'timeout': return 'location not available — timed out, check GPS is on';
    case 'unsupported': return 'location not available — browser does not support it';
    default: return 'location not available';
  }
}

